---
// ---------------------------------------------------------------------------
// Aura — a fixed, full-viewport WebGL background: a photograph of light rays,
// slowly stirred by turbulence and printed through an ordered (Bayer) dither.
//
// The canvas is rendered at one pixel per dither cell and scaled up with hard
// edges, so every dot of the pattern stays crisp and the shader only runs for
// a fraction of the screen's pixels. The page sets `--aura-intensity` to how
// bright the image may get behind its text.
// ---------------------------------------------------------------------------

const texture = '/textures/god3.png';
---

<div class="aura" aria-hidden="true" style={`--aura-texture: url('${texture}')`}>
	<canvas class="aura__canvas" data-texture={texture}></canvas>
</div>

<script>
	const VERT = `
		attribute vec2 a_pos;
		void main() {
			gl_Position = vec4(a_pos, 0.0, 1.0);
		}
	`;

	const FRAG = `
		#ifdef GL_FRAGMENT_PRECISION_HIGH
		precision highp float;
		#else
		precision mediump float;
		#endif

		uniform sampler2D u_tex;
		uniform vec2 u_res;
		uniform float u_texAspect;
		uniform float u_time;
		uniform float u_intensity;
		// Smoothed scroll speed, signed by direction: 0 at rest, ±1 at a fast scroll.
		uniform float u_stir;

		// Output levels per channel. Two gives the eight-colour palette (black,
		// white, and the pure primaries and secondaries), so every dot is either
		// off or a fully saturated colour, and the dither pattern carries all of
		// the gradients.
		#define LEVELS 5.0
		// Grading applied to the photo before it is dithered: gamma below 1 lifts
		// the shadows and midtones, exposure scales everything, saturation pushes
		// colours away from grey, so the dither lands on colour instead of grey.
		#define GAMMA 1.3
		#define EXPOSURE 1.5
		#define SATURATION 1.6

		float hash12(vec2 p) {
			vec3 p3 = fract(vec3(p.xyx) * 0.1031);
			p3 += dot(p3, p3.yzx + 33.33);
			return fract((p3.x + p3.y) * p3.z);
		}

		float noise(vec2 p) {
			vec2 i = floor(p);
			vec2 f = fract(p);
			vec2 u = f * f * (3.0 - 2.0 * f);
			float a = hash12(i);
			float b = hash12(i + vec2(1.0, 0.0));
			float c = hash12(i + vec2(0.0, 1.0));
			float d = hash12(i + vec2(1.0, 1.0));
			return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
		}

		float fbm(vec2 p) {
			float v = 0.0;
			float a = 0.5;
			for (int i = 0; i < 4; i++) {
				v += a * noise(p);
				p = p * 2.02 + vec2(17.3, 9.1);
				a *= 0.5;
			}
			return v;
		}

		// The 8x8 Bayer threshold matrix, built up from the 2x2 one, in [0, 1).
		float bayer2(vec2 a) {
			a = floor(a);
			return fract(dot(a, vec2(0.5, a.y * 0.75)));
		}

		float bayer4(vec2 a) {
			return bayer2(0.5 * a) * 0.25 + bayer2(a);
		}

		float bayer8(vec2 a) {
			return bayer4(0.5 * a) * 0.25 + bayer2(a);
		}

		void main() {
			vec2 uv = gl_FragCoord.xy / u_res;
			float t = u_time;

			// Cover the viewport like background-size: cover.
			float viewAspect = u_res.x / u_res.y;
			vec2 st = uv - 0.5;
			if (viewAspect > u_texAspect) st.y *= u_texAspect / viewAspect;
			else st.x *= viewAspect / u_texAspect;

			// Zoomed in a touch so the displaced edges never pull in from outside,
			// and drifting very slowly.
			st = st / 1.1 + 0.5 + vec2(sin(t * 0.043), cos(t * 0.031)) * 0.012;

			// Turbulence: a noise field warped by another noise field, so the
			// displacement curls instead of just sliding.
			vec2 p = st * vec2(3.0, 2.2);
			vec2 w1 = vec2(
				fbm(p + vec2(0.0, t * 0.09)),
				fbm(p + vec2(5.2, 1.3) - vec2(t * 0.075, 0.0))
			);
			vec2 w2 = vec2(
				fbm(p + 3.0 * w1 + vec2(1.7, 9.2) + t * 0.05),
				fbm(p + 3.0 * w1 + vec2(8.3, 2.8) - t * 0.045)
			);
			// Scrolling stirs it harder, and drags the image along with the page.
			// The drag is weighted by the turbulence, so it smears rather than pans,
			// and springs back as the scroll settles.
			st += (w2 - 0.5) * (0.06 + 0.07 * abs(u_stir));
			st.y -= u_stir * 0.035 * w1.x;

			// Texture rows run top to bottom; gl_FragCoord runs bottom to top.
			vec3 col = texture2D(u_tex, vec2(st.x, 1.0 - st.y)).rgb;

			col = pow(col, vec3(GAMMA)) * EXPOSURE;
			float luma = dot(col, vec3(0.299, 0.587, 0.114));
			col = clamp(mix(vec3(luma), col, SATURATION), 0.0, 1.0);

			// Ordered dither down to a few levels per channel.
			float threshold = bayer8(gl_FragCoord.xy) + 0.5 / 64.0;
			col = floor(col * (LEVELS - 1.0) + threshold) / (LEVELS - 1.0);

			// Dimmed only after dithering: the dots keep their full colour and the
			// intensity works like the opacity of the whole layer.
			gl_FragColor = vec4(col * u_intensity, 1.0);
		}
	`;

	// The motion is slow, so there is no use drawing it faster than this.
	const FPS = 30;
	// Size of one dither cell, in CSS pixels.
	const CELL = 3;
	// Scrolling stirs the turbulence: at full stir it evolves this many times
	// faster than at rest, on top of its normal pace.
	const ACCEL = 6;
	// Scroll speed, in viewport heights per second, that counts as a full stir.
	const FULL_STIR = 2.5;
	// How quickly the stir builds when scrolling starts, and how slowly it
	// settles after, in seconds.
	const ATTACK = 0.08;
	const RELEASE = 0.9;
	// The photo is resampled to this power-of-two size so WebGL 1 can mipmap it,
	// which keeps it from shimmering when it is drawn this much smaller.
	const TEX_SIZE = [1024, 512];

	// The moment in the motion that a still frame shows.
	const STILL = 40;

	const canvas = document.querySelector<HTMLCanvasElement>('.aura__canvas');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (canvas) {
		const image = new Image();
		image.decoding = 'async';
		image.addEventListener('load', () => start(canvas, image));
		image.src = canvas.dataset.texture ?? '';
	}

	function start(canvas: HTMLCanvasElement, image: HTMLImageElement) {
		const gl = canvas.getContext('webgl', {
			alpha: false,
			antialias: false,
			depth: false,
			stencil: false,
			powerPreference: 'low-power',
			preserveDrawingBuffer: false,
		});
		// No WebGL: the container's CSS copy of the image stays as the background.
		if (!gl) return;

		const texAspect = image.naturalWidth / image.naturalHeight;
		let uniforms: Record<string, WebGLUniformLocation | null> = {};
		let intensity = 1;
		let frame = 0;
		let last = -Infinity;
		// Turbulence time, which scrolling runs faster. It starts part-way in so
		// the first frame is already mid-motion.
		let flow = STILL;
		let stir = 0;
		let scrolled = 0;
		let lastScrollY = window.scrollY;

		window.addEventListener(
			'scroll',
			() => {
				scrolled += window.scrollY - lastScrollY;
				lastScrollY = window.scrollY;
			},
			{ passive: true }
		);

		function compile(type: number, source: string) {
			const shader = gl!.createShader(type)!;
			gl!.shaderSource(shader, source);
			gl!.compileShader(shader);
			if (!gl!.getShaderParameter(shader, gl!.COMPILE_STATUS)) {
				console.error(gl!.getShaderInfoLog(shader));
			}
			return shader;
		}

		function init() {
			const program = gl!.createProgram()!;
			gl!.attachShader(program, compile(gl!.VERTEX_SHADER, VERT));
			gl!.attachShader(program, compile(gl!.FRAGMENT_SHADER, FRAG));
			gl!.linkProgram(program);
			if (!gl!.getProgramParameter(program, gl!.LINK_STATUS)) {
				console.error(gl!.getProgramInfoLog(program));
				return false;
			}
			gl!.useProgram(program);

			// One triangle covering the viewport.
			const buffer = gl!.createBuffer();
			gl!.bindBuffer(gl!.ARRAY_BUFFER, buffer);
			gl!.bufferData(gl!.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl!.STATIC_DRAW);
			const loc = gl!.getAttribLocation(program, 'a_pos');
			gl!.enableVertexAttribArray(loc);
			gl!.vertexAttribPointer(loc, 2, gl!.FLOAT, false, 0, 0);

			const pot = document.createElement('canvas');
			[pot.width, pot.height] = TEX_SIZE;
			pot.getContext('2d')!.drawImage(image, 0, 0, pot.width, pot.height);

			const texture = gl!.createTexture();
			gl!.bindTexture(gl!.TEXTURE_2D, texture);
			gl!.texImage2D(gl!.TEXTURE_2D, 0, gl!.RGB, gl!.RGB, gl!.UNSIGNED_BYTE, pot);
			gl!.generateMipmap(gl!.TEXTURE_2D);
			gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_MIN_FILTER, gl!.LINEAR_MIPMAP_LINEAR);
			gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_MAG_FILTER, gl!.LINEAR);
			gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_WRAP_S, gl!.CLAMP_TO_EDGE);
			gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_WRAP_T, gl!.CLAMP_TO_EDGE);

			uniforms = {};
			for (const name of ['u_tex', 'u_res', 'u_texAspect', 'u_time', 'u_intensity', 'u_stir']) {
				uniforms[name] = gl!.getUniformLocation(program, name);
			}
			gl!.uniform1i(uniforms.u_tex, 0);
			return true;
		}

		function resize() {
			const box = canvas.parentElement!;
			const dpr = window.devicePixelRatio || 1;
			// A whole number of device pixels per cell, so every cell is the same size.
			const cell = Math.max(1, Math.round(CELL * dpr));
			const width = Math.max(1, Math.ceil((box.clientWidth * dpr) / cell));
			const height = Math.max(1, Math.ceil((box.clientHeight * dpr) / cell));
			if (canvas.width !== width || canvas.height !== height) {
				canvas.width = width;
				canvas.height = height;
			}
			// Sized to exactly cell × canvas pixels; the container clips the overhang.
			canvas.style.width = `${(width * cell) / dpr}px`;
			canvas.style.height = `${(height * cell) / dpr}px`;
			gl!.viewport(0, 0, width, height);

			const value = parseFloat(getComputedStyle(canvas).getPropertyValue('--aura-intensity'));
			intensity = Number.isFinite(value) ? value : 1;
		}

		function draw(time: number, stirring: number) {
			gl!.uniform2f(uniforms.u_res, canvas.width, canvas.height);
			gl!.uniform1f(uniforms.u_texAspect, texAspect);
			gl!.uniform1f(uniforms.u_time, time);
			gl!.uniform1f(uniforms.u_intensity, intensity);
			gl!.uniform1f(uniforms.u_stir, stirring);
			gl!.drawArrays(gl!.TRIANGLES, 0, 3);
			canvas.classList.add('is-live');
		}

		function tick(now: number) {
			frame = requestAnimationFrame(tick);
			if (now - last < 1000 / FPS - 2) return;
			// Capped, so coming back to a hidden tab doesn't jump the motion.
			const dt = Math.min((now - last) / 1000, 0.1);
			last = now;

			const speed = scrolled / window.innerHeight / dt;
			scrolled = 0;
			const target = Math.max(-1, Math.min(1, speed / FULL_STIR));
			const tau = Math.abs(target) > Math.abs(stir) ? ATTACK : RELEASE;
			stir += (target - stir) * (1 - Math.exp(-dt / tau));

			flow += dt * (1 + ACCEL * Math.abs(stir));
			draw(flow, stir);
		}

		function run() {
			cancelAnimationFrame(frame);
			resize();
			// Reduced motion gets a single still frame, and scrolling leaves it be.
			if (reduceMotion.matches) draw(STILL, 0);
			else frame = requestAnimationFrame(tick);
		}

		if (!init()) return;
		run();

		new ResizeObserver(() => {
			resize();
			if (reduceMotion.matches) draw(STILL, 0);
		}).observe(canvas.parentElement!);
		reduceMotion.addEventListener('change', run);

		canvas.addEventListener('webglcontextlost', (event) => {
			event.preventDefault();
			cancelAnimationFrame(frame);
		});
		canvas.addEventListener('webglcontextrestored', () => {
			if (init()) run();
		});
	}
</script>

<style>
	.aura {
		position: fixed;
		z-index: -1;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		background: #000;
	}

	/* The plain photo at the same brightness: shown until the first frame,
	   and instead of it without WebGL. */
	.aura::before {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--aura-texture) center / cover no-repeat;
		opacity: var(--aura-intensity, 1);
	}

	.aura__canvas {
		position: relative;
		display: block;
		image-rendering: pixelated;
		opacity: 0;
		transition: opacity 1200ms ease;
	}

	.aura__canvas.is-live {
		opacity: 1;
	}
</style>
