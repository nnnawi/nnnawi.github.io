---
interface Props {
	/** Which entry is highlighted. Matches the `href` of one of the links. */
	active?: string;
}

const { active } = Astro.props;

const links = [
	{ label: 'Home', href: '/' },
	{ label: 'Projects', href: '/projects' },
	{ label: 'About me', href: '/about' },
];
---

<nav class="nav" aria-label="Main">
	<ul class="nav__list">
		{
			links.map((link) => (
				<li>
					<a
						class:list={['nav__link', active === link.href && 'nav__link--active']}
						href={link.href}
						aria-current={active === link.href ? 'page' : undefined}
					>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.nav {
		position: fixed;
		z-index: 20;
		inset-block-start: clamp(1rem, 2.5vh, 1.75rem);
		inset-inline: 0;
		display: flex;
		justify-content: center;
		pointer-events: none;
	}

	.nav__list {
		position: relative;
		display: flex;
		gap: 0.25rem;
		margin: 0;
		padding: 0.3rem;
		list-style: none;
		pointer-events: auto;
		border-radius: 999px;
		/* Frosted pill: the page shows through, blurred and slightly lifted. */
		background: rgba(18, 21, 29, 0.45);
		backdrop-filter: blur(18px) saturate(150%);
		-webkit-backdrop-filter: blur(18px) saturate(150%);
		box-shadow:
			0 1px 2px rgba(5, 7, 12, 0.35),
			0 20px 44px -26px rgba(0, 0, 0, 0.9),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	/* Light catching the rim of the pill. */
	.nav__list::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		border-radius: inherit;
		padding: 1px;
		opacity: 0.45;
		background: linear-gradient(
			150deg,
			rgba(255, 255, 255, 0.8) 0%,
			rgba(255, 255, 255, 0.2) 20%,
			rgba(255, 255, 255, 0.03) 45%,
			rgba(255, 255, 255, 0.12) 72%,
			rgba(255, 255, 255, 0.5) 100%
		);
		/* Longhands only: the production minifier reorders declarations, and a
		   `mask` shorthand landing after `mask-composite` would reset it, filling
		   the whole pill with the gradient instead of just its rim. */
		-webkit-mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);
		-webkit-mask-clip: content-box, border-box;
		-webkit-mask-composite: xor;
		mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);
		mask-clip: content-box, border-box;
		mask-composite: exclude;
	}

	.nav__link {
		display: block;
		padding: 0.55rem clamp(0.85rem, 2.2vw, 1.35rem);
		border-radius: 999px;
		color: rgba(232, 234, 240, 0.68);
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-size: clamp(0.8rem, 1.1vw, 0.925rem);
		font-weight: 400;
		letter-spacing: -0.01em;
		white-space: nowrap;
		text-decoration: none;
		transition:
			color 200ms ease,
			background-color 200ms ease;
	}

	.nav__link:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.07);
	}

	.nav__link--active {
		color: #05070c;
		background: rgba(255, 255, 255, 0.92);
	}

	.nav__link--active:hover {
		color: #05070c;
		background: #fff;
	}

	.nav__link:focus-visible {
		outline: 2px solid rgba(232, 234, 240, 0.75);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.nav__link {
			transition: none;
		}
	}
</style>
