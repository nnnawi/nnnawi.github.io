---
// ---------------------------------------------------------------------------
// Project template — everything a project needs lives in this block.
// Copy this file, swap the data, keep the markup.
// ---------------------------------------------------------------------------
const project = {
	title: 'Bowde',
	tagline: 'A browser-based control-systems workbench: type a transfer function and watch Bode, Nyquist, Nichols, pole-zero and time-response diagrams redraw together as you sweep its parameters.',
	meta: [
		{ label: 'Discipline', value: 'Control theory · Numerical methods' },
		{ label: 'Stack', value: 'Angular, TypeScript, p5.js, mathjs, MathLive' },
		{ label: 'Year', value: '2019 · rebuilt 2026' },
		{ label: 'Role', value: 'Self initiated · licensed for teaching' },
	],
	hero: '/project_animation/BOWDE_animation.mp4',
	// Primary call to action. Drop the key to hide the link.
	live: {
		url: 'https://nnnawi.github.io/BOWDE/',
		label: 'Open Bowde',
	},
	// Repository. `private: true` swaps the link for a locked badge plus an access
	// request, and `url` is then ignored. Drop the whole key to hide the row.
	repo: {
		url: 'https://github.com/nnnawi/BOWDE',
		private: false,
		contact: 'iwan@ibnoulouafi.com',
	},
	sections: [
		{
			label: 'Overview',
			title: 'Desmos, but for transfer functions',
			body: [
				'In MPSI preparatory classes I leaned on Bode and time-response diagrams to understand how a dynamic system actually behaves, and then to tune it. Outside professional software like MATLAB there was nothing lightweight that could draw those diagrams from a transfer function and keep them live while you changed it. Bowde exists to be the free, instant, browser-based version of that loop.',
				'The model it borrows is the graphing calculator, not the simulation package. You type G(p), every diagram appears at once, and dragging a parameter slider moves all of them together. There is no project to set up, nothing to install, and no backend — the whole thing runs client-side in a tab.',
				'That immediacy is the pedagogical point. The distance between a formula and the behaviour it describes is where control theory is usually lost, and it closes much faster when a coefficient is something you can pull on and watch respond than when it is a number you resubmit.',
			],
		},
		{
			label: 'Result',
			title: 'It left my hands and kept going',
			// Paragraphs are rendered as HTML, so inline links are allowed here.
			body: [
				'Once the first version was finished, I licensed it to a physics professor in France who wanted it as an add-on for his course website. It was the first money I ever made on the internet, and it ended up paying for part of my university.',
				'A while later I found out the project had been forked by researchers at a Swedish engineering school, who built on it to teach their own students. It is also cited in one of the research papers that came out of that work: <a href="RESEARCH_PAPER_URL" target="_blank" rel="noopener noreferrer">read the paper</a>.',
			],
		},
	],
	// Outcomes, shown as a card list under the prose.
	highlights: [],
	// Bento media grid — `span` drives how many of the 4 columns a tile takes.
	// Convention: clips live in /project_animation/BOWDE/.
	media: [],
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={project.tagline} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
		/>
		<title>{project.title}</title>
	</head>
	<body>
		<main>
			<a class="back-link" href="/">
				<span class="back-link__arrow" aria-hidden="true">←</span>
				Back to all projects
			</a>

			<header class="project-header">
				<h1 class="project-title">{project.title}</h1>
				<p class="project-tagline">{project.tagline}</p>

				<p class="repo">
					{
						project.live && (
							<a
								class="repo__live"
								href={project.live.url}
								target="_blank"
								rel="noopener noreferrer"
							>
								<svg
									class="repo__icon"
									viewBox="0 0 16 16"
									fill="none"
									stroke="currentColor"
									stroke-width="1.3"
									aria-hidden="true"
								>
									<circle cx="8" cy="8" r="6.25" />
									<path d="M1.75 8h12.5M8 1.75c1.6 1.7 2.5 3.9 2.5 6.25S9.6 12.55 8 14.25C6.4 12.55 5.5 10.35 5.5 8S6.4 3.45 8 1.75Z" />
								</svg>
								{project.live.label}
							</a>
						)
					}

					{
						project.repo &&
							(project.repo.private ? (
								<span class="repo__badge">
									<svg
										class="repo__icon"
										viewBox="0 0 16 16"
										fill="none"
										stroke="currentColor"
										stroke-width="1.3"
										aria-hidden="true"
									>
										<rect x="3.25" y="7" width="9.5" height="6.75" rx="1.6" />
										<path d="M5.75 7V4.75a2.25 2.25 0 0 1 4.5 0V7" />
									</svg>
									Private repository
								</span>
							) : (
								<a
									class="repo__link"
									href={project.repo.url}
									target="_blank"
									rel="noopener noreferrer"
								>
									<svg class="repo__icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
										<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
									</svg>
									View source on GitHub
								</a>
							))
					}
				</p>

				<dl class="project-meta">
					{
						project.meta.map((item) => (
							<div class="project-meta__row">
								<dt class="project-meta__label">{item.label}</dt>
								<dd class="project-meta__value">{item.value}</dd>
							</div>
						))
					}
				</dl>
			</header>

			<figure class="hero">
				<video
					class="hero__video"
					src={project.hero}
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
					tabindex="-1"
					aria-hidden="true"
					data-project-video></video>
			</figure>

			<div class="prose">
				{
					project.sections.map((section) => (
						<section class="prose__section">
							<p class="prose__label">{section.label}</p>
							<div class="prose__body">
								<h2 class="prose__heading">{section.title}</h2>
								{section.body.map((paragraph) => (
									<p class="prose__paragraph" set:html={paragraph} />
								))}
							</div>
						</section>
					))
				}
			</div>


			{
				project.media.length > 0 && (
					<section class="gallery" aria-label="Project gallery">
						<p class="gallery__label">Selected frames</p>
						<div class="bento-grid">
							{project.media.map((item) => (
								<figure
									class:list={['media-card', `span-${item.span}`]}
									style={`--media-ratio: ${item.ratio}`}
								>
									<video
										class="media-card__video"
										src={item.video}
										autoplay
										muted
										loop
										playsinline
										preload="metadata"
										tabindex="-1"
										aria-hidden="true"
										data-project-video
									/>
									<div class="media-card__frost" aria-hidden="true" />
									{item.caption && (
										<figcaption class="media-card__caption">{item.caption}</figcaption>
									)}
								</figure>
							))}
						</div>
					</section>
				)
			}

			<footer class="site-footer">
				<span>Iwan Ibnoulouafi</span>
				<a href="mailto:iwan@ibnoulouafi.com">iwan@ibnoulouafi.com</a>
			</footer>
		</main>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		background: #05070c;
		color: #e8eaf0;
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-weight: 350;
	}

	main {
		max-inline-size: 1100px;
		margin-inline: auto;
		padding: clamp(1.5rem, 5vw, 4rem) clamp(1rem, 4vw, 2rem);
	}

	/* --- Back link ------------------------------------------------------- */

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		color: rgba(232, 234, 240, 0.55);
		font-size: 0.85rem;
		letter-spacing: 0.01em;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.back-link:hover {
		color: rgba(232, 234, 240, 0.9);
	}

	.back-link__arrow {
		display: inline-block;
		transition: transform 160ms ease;
	}

	.back-link:hover .back-link__arrow {
		transform: translateX(-3px);
	}

	/* --- Header ---------------------------------------------------------- */

	.project-header {
		margin-block: clamp(2.5rem, 7vw, 5rem) clamp(1.5rem, 4vw, 2.5rem);
	}

	.project-title {
		margin: 0;
		font-size: clamp(2.75rem, 9vw, 5.5rem);
		font-weight: 350;
		line-height: 0.98;
		letter-spacing: -0.035em;
	}

	.project-tagline {
		margin: clamp(1rem, 2.5vw, 1.5rem) 0 0;
		max-inline-size: 46ch;
		font-size: clamp(1rem, 1.6vw, 1.2rem);
		line-height: 1.45;
		color: rgba(232, 234, 240, 0.62);
		text-wrap: pretty;
	}

	/* --- Repository ------------------------------------------------------ */

	.repo {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
		font-size: 0.85rem;
	}

	.repo__live,
	.repo__link,
	.repo__badge {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.5em 0.95em;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.03);
		line-height: 1;
		text-decoration: none;
	}

	/* The live app is the primary destination, so it carries the solid fill. */
	.repo__live {
		border-color: rgba(255, 255, 255, 0.85);
		background: rgba(232, 234, 240, 0.92);
		color: #05070c;
		transition:
			background-color 160ms ease,
			border-color 160ms ease;
	}

	.repo__live:hover {
		border-color: #fff;
		background: #fff;
	}

	.repo__link {
		color: rgba(232, 234, 240, 0.82);
		transition:
			color 160ms ease,
			border-color 160ms ease,
			background-color 160ms ease;
	}

	.repo__link:hover {
		color: #e8eaf0;
		border-color: rgba(255, 255, 255, 0.28);
		background: rgba(255, 255, 255, 0.07);
	}

	.repo__badge {
		color: rgba(232, 234, 240, 0.5);
	}

	.repo__icon {
		flex: none;
		inline-size: 1.05em;
		block-size: 1.05em;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.project-meta {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
		margin: clamp(2rem, 5vw, 3.25rem) 0 0;
		padding-block-start: 1.25rem;
		border-block-start: 1px solid rgba(255, 255, 255, 0.09);
	}

	.project-meta__row {
		display: flex;
		flex-direction: column;
		gap: 0.4em;
	}

	.project-meta__label {
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(232, 234, 240, 0.38);
	}

	.project-meta__value {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.35;
		color: rgba(232, 234, 240, 0.88);
		text-wrap: pretty;
	}

	/* --- Hero ------------------------------------------------------------ */

	.hero {
		position: relative;
		margin: 0;
		aspect-ratio: 21 / 9;
		overflow: hidden;
		isolation: isolate;
		border-radius: 20px;
		background-color: #0a0c11;
		box-shadow:
			0 1px 2px rgba(5, 7, 12, 0.28),
			0 30px 60px -30px rgba(5, 7, 12, 0.8);
	}

	.hero__video {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		transform: scale(1.015);
	}

	/* Same liquid-glass edge treatment as the bento cards on the index page. */
	.hero::after,
	.media-card::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 4;
		pointer-events: none;
		border-radius: inherit;
		padding: 1px;
		opacity: 40%;
		background: linear-gradient(
			150deg,
			rgba(255, 255, 255, 0.75) 0%,
			rgba(255, 255, 255, 0.22) 18%,
			rgba(255, 255, 255, 0.04) 42%,
			rgba(255, 255, 255, 0.1) 70%,
			rgba(255, 255, 255, 0.45) 100%
		);
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
	}

	.hero::before,
	.media-card::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		border-radius: inherit;
		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.16) 0%,
				rgba(255, 255, 255, 0.05) 22%,
				rgba(255, 255, 255, 0) 46%
			),
			radial-gradient(
				120% 80% at 85% 0%,
				rgba(255, 255, 255, 0.12) 0%,
				rgba(255, 255, 255, 0) 55%
			);
		mix-blend-mode: screen;
	}

	/* --- Prose ----------------------------------------------------------- */

	.prose {
		display: flex;
		flex-direction: column;
		gap: clamp(2.5rem, 6vw, 4rem);
		margin-block: clamp(3rem, 8vw, 5.5rem);
	}

	.prose__section {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
		gap: clamp(1rem, 3vw, 2rem);
	}

	.prose__label {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(232, 234, 240, 0.38);
	}

	.prose__body {
		max-inline-size: 62ch;
	}

	.prose__heading {
		margin: 0 0 0.9em;
		font-size: clamp(1.35rem, 2.6vw, 1.85rem);
		font-weight: 350;
		line-height: 1.2;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.prose__paragraph {
		margin: 0 0 1em;
		font-size: clamp(0.95rem, 1.4vw, 1.05rem);
		line-height: 1.6;
		color: rgba(232, 234, 240, 0.68);
		text-wrap: pretty;
	}

	.prose__paragraph:last-child {
		margin-block-end: 0;
	}

	.prose__paragraph a {
		color: rgba(232, 234, 240, 0.92);
		text-decoration: underline;
		text-decoration-color: rgba(232, 234, 240, 0.35);
		text-underline-offset: 0.2em;
		transition: text-decoration-color 160ms ease;
	}

	.prose__paragraph a:hover {
		text-decoration-color: rgba(232, 234, 240, 0.85);
	}

	/* --- Bento grid ------------------------------------------------------ */

	.bento-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		align-items: start;
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
	}

	.bento-grid > .span-2 {
		grid-column: span 2;
	}

	.bento-grid > .span-4 {
		grid-column: span 4;
	}

	.gallery__label,
	.highlights__label {
		margin: 0 0 clamp(1rem, 2vw, 1.5rem);
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(232, 234, 240, 0.38);
	}

	/* --- Outcomes -------------------------------------------------------- */

	.highlights {
		margin-block-start: clamp(3rem, 8vw, 5.5rem);
	}

	.highlights__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(0.6rem, 1.5vw, 1rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.highlights__item {
		display: flex;
		align-items: flex-start;
		gap: 0.85em;
		padding: clamp(0.9rem, 2vw, 1.15rem) clamp(1rem, 2.5vw, 1.35rem);
		border: 1px solid rgba(255, 255, 255, 0.09);
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.02);
		font-size: clamp(0.9rem, 1.4vw, 1rem);
		line-height: 1.45;
		color: rgba(232, 234, 240, 0.68);
		text-wrap: pretty;
	}

	.highlights__marker {
		flex: none;
		inline-size: 0.32em;
		block-size: 0.32em;
		margin-block-start: 0.72em;
		border-radius: 999px;
		background: rgba(232, 234, 240, 0.4);
	}

	.gallery {
		margin-block-start: clamp(3rem, 8vw, 5.5rem);
	}

	.media-card {
		position: relative;
		margin: 0;
		aspect-ratio: var(--media-ratio, 16 / 9);
		overflow: hidden;
		isolation: isolate;
		border-radius: 20px;
		background-color: #0a0c11;
		box-shadow:
			0 1px 2px rgba(5, 7, 12, 0.28),
			0 18px 40px -22px rgba(5, 7, 12, 0.7);
		container-type: inline-size;
	}

	.media-card__video {
		position: absolute;
		inset: 0;
		z-index: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		transform: scale(1.015);
	}

	.media-card__frost {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		backdrop-filter: blur(14px) saturate(130%);
		-webkit-backdrop-filter: blur(14px) saturate(130%);
		background: linear-gradient(
			to top,
			rgba(8, 10, 16, 0.55) 0%,
			rgba(8, 10, 16, 0.22) 30%,
			rgba(8, 10, 16, 0) 60%
		);
		mask-image: linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.6) 26%, transparent 58%);
		-webkit-mask-image: linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.6) 26%, transparent 58%);
	}

	.media-card__caption {
		position: absolute;
		inset-block-end: 0;
		inset-inline: 0;
		z-index: 3;
		padding: clamp(0.875rem, 4.5cqi, 1.5rem);
		font-size: clamp(0.75rem, 2.2cqi, 0.9rem);
		line-height: 1.35;
		color: rgba(255, 255, 255, 0.72);
		text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);
		text-wrap: pretty;
	}

	/* --- Footer ---------------------------------------------------------- */

	.site-footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		margin-block-start: clamp(3rem, 8vw, 5.5rem);
		padding-block-start: 1.25rem;
		border-block-start: 1px solid rgba(255, 255, 255, 0.09);
		font-size: 0.85rem;
		color: rgba(232, 234, 240, 0.45);
	}

	.site-footer a {
		color: inherit;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.site-footer a:hover {
		color: rgba(232, 234, 240, 0.9);
	}

	/* --- Responsive ------------------------------------------------------ */

	@media (max-width: 720px) {
		.project-meta {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.25rem;
		}

		.prose__section {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.75rem;
		}

		.bento-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.highlights__list {
			grid-template-columns: minmax(0, 1fr);
		}

		.bento-grid > .span-4 {
			grid-column: span 2;
		}

		.hero {
			aspect-ratio: 16 / 9;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__video,
		.media-card__video {
			transform: none;
		}

		.back-link__arrow {
			transition: none;
		}
	}
</style>

<script>
	// Autoplaying video is motion: honour the OS setting and show the first frame instead.
	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-project-video]')) {
			video.autoplay = false;
			video.pause();
		}
	}
</script>
