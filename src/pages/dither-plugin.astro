---
// ---------------------------------------------------------------------------
// Project template — everything a project needs lives in this block.
// Copy this file, swap the data, keep the markup.
// ---------------------------------------------------------------------------
const project = {
	title: 'Dither Plugin',
	tagline: 'A professional-grade dithering plugin for After Effects with GPU kernels written to keep all of it running in real time.',
	meta: [
		{ label: 'Stack', value: 'After Effects SDK, C++, CUDA, Metal' },
		{ label: 'Year', value: '2026' },
	],
	hero: '/project_animation/DitherPlugin/Dither_main.mp4',
	// Repository. `private: true` swaps the link for a locked badge plus an access
	// request, and `url` is then ignored. Drop the whole key to hide the row.
	repo: {
		url: null,
		private: true,
		contact: 'iwan@ibnoulouafi.com',
	},
	sections: [
		{
			label: 'Overview',
			title: 'Twelve years in After Effects, and still no dithering plugin I wanted',
			body: [
				'After Effects is the software I have used the most, for over twelve years. I have also built several plugins for it, usually to solve problems that existing tools did not address. Dithering is one of them.',
				'Existing dithering plugins generally offer only a few algorithms and basic controls. I wanted full control over the process, with each stage of the pipeline exposed and editable.',
				'Dithering is also the kind of subject I enjoy for its own sake. There is a lot of genuinely creative coding in it (FM modulation dithering in particular), with algorithms that are unusual enough to make the implementation interesting.',
			],
		},
		{
			label: 'Approach',
			title: 'Making sequential algorithms run in parallel',
			body: [
				'The constraint I set at the start was real time performance. An effect you have to render to preview is an effect you stop experimenting with, and experimenting is the whole point. Real time means the GPU and thus parallelization.',
				'But dithering algorithms like error diffusion are inherently sequential: each pixel depends on the error propagated by previous ones. Rewriting these algorithms for thousands of threads without losing their characteristic look was the hardest and most interesting part of the project.'
			],
		},
	],
	// Plugin parameter surface, rendered as a single vertical list.
	features: [
		{
			label: 'Dithering methods',
			value: 'Error diffusion, Ordered dithering, Halftoning and FM modulation. (30+ presets)',
		},
		{
			label: 'Sampling',
			value: 'Pixel scale, with bilinear or nearest-neighbour resampling.',
		},
		{
			label: 'Channels',
			value: 'Dither colour, alpha, or colour + alpha.',
		},
		{
			label: 'Colour',
			value: 'Full RGB or palette-quantised output. (20+ palettes & image-derived palette)',
		},
		{
			label: 'Preprocessing',
			value: 'Sharpen, Gaussian blur, noise, contrast, midtones and highlights, applied before quantisation.',
		},
		{
			label: 'Postprocessing',
			value: 'Pixel smoothing on the dithered result.',
		},
	],
	// Headline numbers, rendered as a tile row under the hero.
	results: [
		{ value: '4', label: 'Algorithm Families', detail: 'Error diffusion, ordered dithering, halftoning and FM modulation.' },
		{ value: '60 FPS', label: 'Real time', detail: 'On 1080p footage, on an Apple M3 with 8 GB of RAM.' },
		{ value: '30+', label: 'Presets', detail: 'Dithering patterns, plus 20+ colour palettes and palettes taken from any image.' },
		{ value: '6', label: 'Editable stages', detail: 'From sampling and preprocessing to palette and smoothing, every parameter exposed.' },
	],
	// Bento media grid — `span` drives how many of the 4 columns a tile takes.
	// Convention: clips live in /project_animation/DitherPlugin/.
	media: [
		{ video: '/project_animation/DitherPlugin/Dither_type.mp4', caption: 'Switching between dithering types.', span: 2, ratio: '16 / 9' },
		{ video: '/project_animation/DitherPlugin/Dither_palette.mp4', caption: 'Palette selection and image-derived palettes.', span: 2, ratio: '16 / 9' },
		{ video: '/project_animation/DitherPlugin/Dither_preprocess.mp4', caption: 'The preprocessing chain ahead of quantisation.', span: 2, ratio: '16 / 9' },
		{ video: '/project_animation/DitherPlugin/Dither_smooth.mp4', caption: 'Pixel smoothing on the dithered output.', span: 2, ratio: '16 / 9' },
	],
};

const pad = (index: number) => String(index + 1).padStart(2, '0');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={project.tagline} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
		/>
		<title>{project.title}</title>
	</head>
	<body>
		<main>
			<a class="back-link" href="/projects">
				<span class="back-link__arrow" aria-hidden="true">←</span>
				Back to all projects
			</a>

			<header class="project-header">
				<h1 class="project-title">{project.title}</h1>
				<p class="project-tagline">{project.tagline}</p>

				<p class="repo">
					{
						project.repo &&
							(project.repo.private ? (
								<span class="repo__badge">
									<svg
										class="repo__icon"
										viewBox="0 0 16 16"
										fill="none"
										stroke="currentColor"
										stroke-width="1.3"
										aria-hidden="true"
									>
										<rect x="3.25" y="7" width="9.5" height="6.75" rx="1.6" />
										<path d="M5.75 7V4.75a2.25 2.25 0 0 1 4.5 0V7" />
									</svg>
									Private repository
								</span>
							) : (
								<a
									class="repo__link"
									href={project.repo.url}
									target="_blank"
									rel="noopener noreferrer"
								>
									<svg class="repo__icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
										<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
									</svg>
									View source on GitHub
								</a>
							))
					}

					<span class="project-meta">
						{project.meta.map((item) => (
							<span class="project-meta__item" title={item.label}>
								{item.value}
							</span>
						))}
					</span>
				</p>
			</header>

			<figure class="hero">
				<video
					class="hero__video"
					src={project.hero}
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
					tabindex="-1"
					aria-hidden="true"
					data-project-video></video>
			</figure>

			{
				project.results.length > 0 && (
					<section class="results" aria-label="Headline results">
						<div class="results__grid">
							{project.results.map((item) => (
								<div class="results__tile">
									<p class="results__value">{item.value}</p>
									<p class="results__name">{item.label}</p>
									<p class="results__detail">{item.detail}</p>
								</div>
							))}
						</div>
					</section>
				)
			}

			<div class="prose">
				{
					project.sections.map((section) => (
						<section class="prose__section">
							<p class="prose__label">{section.label}</p>
							<div class="prose__body">
								<h2 class="prose__heading">{section.title}</h2>
								{section.body.map((paragraph) => (
									<p class="prose__paragraph">{paragraph}</p>
								))}
							</div>
						</section>
					))
				}
			</div>

			{
				project.media.length > 0 && (
					<section class="gallery" aria-label="Project gallery">
						<p class="gallery__label">Selected frames</p>
						<div class="bento-grid">
							{project.media.map((item) => (
								<figure
									class:list={['media-card', `span-${item.span}`]}
									style={`--media-ratio: ${item.ratio}`}
								>
									<video
										class="media-card__video"
										src={item.video}
										autoplay
										muted
										loop
										playsinline
										preload="metadata"
										tabindex="-1"
										aria-hidden="true"
										data-project-video
									/>
									<div class="media-card__frost" aria-hidden="true" />
									{item.caption && (
										<figcaption class="media-card__caption">{item.caption}</figcaption>
									)}
								</figure>
							))}
						</div>
					</section>
				)
			}

			<footer class="site-footer">
				<span>Iwan Ibnoulouafi</span>
			</footer>
		</main>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		background: #05070c;
		color: #e8eaf0;
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-weight: 350;
	}

	main {
		max-inline-size: 1100px;
		margin-inline: auto;
		padding: clamp(1.5rem, 5vw, 4rem) clamp(1rem, 4vw, 2rem);
	}

	/* --- Back link ------------------------------------------------------- */

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		color: rgba(232, 234, 240, 0.55);
		font-size: 0.85rem;
		letter-spacing: 0.01em;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.back-link:hover {
		color: rgba(232, 234, 240, 0.9);
	}

	.back-link__arrow {
		display: inline-block;
		transition: transform 160ms ease;
	}

	.back-link:hover .back-link__arrow {
		transform: translateX(-3px);
	}

	/* --- Header ---------------------------------------------------------- */

	.project-header {
		margin-block: clamp(2.5rem, 7vw, 5rem) clamp(1.5rem, 4vw, 2.5rem);
	}

	.project-title {
		margin: 0;
		font-size: clamp(2.75rem, 9vw, 5.5rem);
		font-weight: 450;
		line-height: 0.98;
		letter-spacing: -0.035em;
	}

	.project-tagline {
		margin: clamp(1rem, 2.5vw, 1.5rem) 0 0;
		max-inline-size: 46ch;
		font-size: clamp(1rem, 1.6vw, 1.2rem);
		line-height: 1.45;
		color: rgba(232, 234, 240, 0.62);
		text-wrap: pretty;
	}

	/* --- Repository ------------------------------------------------------ */

	.repo {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
		font-size: 0.85rem;
	}

	.repo__link,
	.repo__badge {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.5em 0.95em;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.03);
		line-height: 1;
		text-decoration: none;
	}

	.repo__link {
		color: rgba(232, 234, 240, 0.82);
		transition:
			color 160ms ease,
			border-color 160ms ease,
			background-color 160ms ease;
	}

	.repo__link:hover {
		color: #e8eaf0;
		border-color: rgba(255, 255, 255, 0.28);
		background: rgba(255, 255, 255, 0.07);
	}

	.repo__badge {
		color: rgba(232, 234, 240, 0.5);
	}

	.repo__icon {
		flex: none;
		inline-size: 1.05em;
		block-size: 1.05em;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.repo__request {
		padding-block-end: 0.15em;
		border-block-end: 1px solid rgba(232, 234, 240, 0.22);
		color: rgba(232, 234, 240, 0.5);
		text-decoration: none;
		transition:
			color 160ms ease,
			border-color 160ms ease;
	}

	.repo__request:hover {
		color: rgba(232, 234, 240, 0.9);
		border-color: rgba(232, 234, 240, 0.55);
	}

	/* Stack and year, unlabelled, on the repository row. */
	.project-meta {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0 0.7em;
		color: rgba(232, 234, 240, 0.55);
	}

	.project-meta__item + .project-meta__item::before {
		content: '·';
		margin-inline-end: 0.7em;
		color: rgba(232, 234, 240, 0.38);
	}

	/* --- Hero ------------------------------------------------------------ */

	.hero {
		position: relative;
		margin: 0;
		aspect-ratio: 21 / 9;
		overflow: hidden;
		isolation: isolate;
		border-radius: 20px;
		/* Safari ignores the rounded overflow for video and blurred layers;
		   a clip-path rounds them reliably. */
		clip-path: inset(0 round 20px);
		background-color: #0a0c11;
		box-shadow:
			0 1px 2px rgba(5, 7, 12, 0.28),
			0 30px 60px -30px rgba(5, 7, 12, 0.8);
	}

	.hero__video {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		transform: scale(1.015);
	}

	/* Same liquid-glass edge treatment as the bento cards on the index page. */
	.hero::after,
	.media-card::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 4;
		pointer-events: none;
		border-radius: inherit;
		padding: 1px;
		opacity: 40%;
		background: linear-gradient(
			150deg,
			rgba(255, 255, 255, 0.75) 0%,
			rgba(255, 255, 255, 0.22) 18%,
			rgba(255, 255, 255, 0.04) 42%,
			rgba(255, 255, 255, 0.1) 70%,
			rgba(255, 255, 255, 0.45) 100%
		);
		/* Longhands only: the production minifier reorders declarations, and a
		   `mask` shorthand landing after `mask-composite` would reset it, filling
		   the whole surface with the gradient instead of just its rim. */
		-webkit-mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);
		-webkit-mask-clip: content-box, border-box;
		-webkit-mask-composite: xor;
		mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);
		mask-clip: content-box, border-box;
		mask-composite: exclude;
	}

	.hero::before,
	.media-card::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		border-radius: inherit;
		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.16) 0%,
				rgba(255, 255, 255, 0.05) 22%,
				rgba(255, 255, 255, 0) 46%
			),
			radial-gradient(
				120% 80% at 85% 0%,
				rgba(255, 255, 255, 0.12) 0%,
				rgba(255, 255, 255, 0) 55%
			);
		mix-blend-mode: screen;
	}

	/* --- Results --------------------------------------------------------- */

	/* The numbers are the deliverable here, so they sit directly under the hero. */
	.results {
		margin-block-start: clamp(1.25rem, 3vw, 2rem);
	}

	.results__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
	}

	.results__tile {
		display: flex;
		flex-direction: column;
		gap: 0.2em;
		padding: clamp(1rem, 2.5vw, 1.4rem) clamp(1rem, 2.5vw, 1.35rem);
		border: 1px solid rgba(255, 255, 255, 0.09);
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.02);
	}

	.results__value {
		margin: 0;
		font-size: clamp(1.6rem, 3.4vw, 2.2rem);
		font-weight: 350;
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: #e8eaf0;
		/* Keeps 3x and -2.8 optically aligned across the row. */
		font-variant-numeric: tabular-nums;
	}

	.results__name {
		margin: 0.25em 0 0;
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(232, 234, 240, 0.38);
	}

	.results__detail {
		margin: 0.5em 0 0;
		font-size: 0.85rem;
		line-height: 1.4;
		color: rgba(232, 234, 240, 0.6);
		text-wrap: pretty;
	}

	/* --- Prose ----------------------------------------------------------- */

	.prose {
		display: flex;
		flex-direction: column;
		gap: clamp(2.5rem, 6vw, 4rem);
		margin-block: clamp(3rem, 8vw, 5.5rem);
	}

	.prose__section {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
		gap: clamp(1rem, 3vw, 2rem);
	}

	.prose__label {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(232, 234, 240, 0.38);
	}

	.prose__body {
		max-inline-size: 62ch;
	}

	.prose__heading {
		margin: 0 0 0.9em;
		font-size: clamp(1.35rem, 2.6vw, 1.85rem);
		font-weight: 350;
		line-height: 1.2;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.prose__paragraph {
		margin: 0 0 1em;
		font-size: clamp(0.95rem, 1.4vw, 1.05rem);
		line-height: 1.6;
		color: rgba(232, 234, 240, 0.68);
		text-wrap: pretty;
	}

	.prose__paragraph:last-child {
		margin-block-end: 0;
	}

	/* --- Feature list ---------------------------------------------------- */

	/* Same 1fr/3fr axis as .prose__section, so the list sits under the body copy
	   instead of starting back at the page margin. */
	.features {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
		gap: clamp(1rem, 3vw, 2rem);
		margin-block-start: clamp(3rem, 8vw, 5.5rem);
	}

	/* A signal chain rather than a bullet list: one spine, one node per stage,
	   read top to bottom in the order the work actually happens. */
	.features__list {
		/* --pad and the 0.75em half-line (line-height 1.5 / 2) are what keep the
		   spine, the node and the first line of text on one axis. Change one of
		   the three and the other two have to follow. */
		--pad: clamp(0.85rem, 2vw, 1.1rem);
		--node: 0.6rem;
		display: flex;
		flex-direction: column;
		/* The negative top cancels the first item's leading pad, so the first
		   spec sits on the label's line the way .prose__heading does. */
		margin: calc(var(--pad) * -1) 0 0;
		padding: 0;
		list-style: none;
	}

	.features__item {
		position: relative;
		display: grid;
		grid-template-columns: 1.5rem minmax(0, 1fr);
		gap: clamp(0.85rem, 2vw, 1.4rem);
		padding-block: var(--pad);
		font-size: clamp(0.9rem, 1.4vw, 1rem);
		line-height: 1.5;
	}

	/* One continuous spine, trimmed at the first and last stage so it starts and
	   stops on a node instead of in mid-air. */
	.features__item::before {
		content: '';
		position: absolute;
		inset-block: 0;
		inset-inline-start: calc(0.75rem - 0.5px);
		inline-size: 1px;
		background: rgba(255, 255, 255, 0.13);
	}

	.features__item:first-child::before {
		inset-block-start: calc(var(--pad) + 0.75em);
	}

	.features__item:last-child::before {
		inset-block-end: calc(100% - var(--pad) - 0.75em);
	}

	.features__node {
		position: relative;
		z-index: 1;
		justify-self: center;
		align-self: start;
		margin-block-start: calc(0.75em - var(--node) / 2);
		inline-size: var(--node);
		block-size: var(--node);
		border: 1px solid rgba(232, 234, 240, 0.4);
		border-radius: 999px;
		background: #05070c;
		transition:
			border-color 220ms ease,
			background-color 220ms ease,
			box-shadow 220ms ease;
	}

	.features__item:hover .features__node {
		border-color: rgba(232, 234, 240, 0.95);
		background: rgba(232, 234, 240, 0.95);
		box-shadow: 0 0 0 4px rgba(232, 234, 240, 0.09);
	}

	.features__text {
		display: flex;
		flex-direction: column;
		gap: 0.3em;
	}

	.features__name {
		display: inline-flex;
		align-items: baseline;
		gap: 0.7em;
		color: rgba(232, 234, 240, 0.9);
	}

	.features__tick {
		font-size: 0.68rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.08em;
		color: rgba(232, 234, 240, 0.28);
		transition: color 220ms ease;
	}

	.features__item:hover .features__tick {
		color: rgba(232, 234, 240, 0.55);
	}

	.features__value {
		max-inline-size: 62ch;
		color: rgba(232, 234, 240, 0.58);
		text-wrap: pretty;
	}

	/* --- Bento grid ------------------------------------------------------ */

	.bento-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		align-items: start;
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
	}

	.bento-grid > .span-2 {
		grid-column: span 2;
	}

	.bento-grid > .span-4 {
		grid-column: span 4;
	}

	.gallery {
		margin-block-start: clamp(3rem, 8vw, 5.5rem);
	}

	.gallery__label,
	.features__label {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(232, 234, 240, 0.38);
	}

