---
import Nav from '../shared/nav/Nav.astro';

// ---------------------------------------------------------------------------
// About page — the résumé, rewritten for the web. Projects live on /projects,
// so nothing here repeats them.
// ---------------------------------------------------------------------------
const profile = {
	name: 'Iwan Ibnoulouafi',
	tagline:
		'Computer vision and machine learning engineer based in Paris. I build software that sits between an algorithm and the person using it — GPU pipelines, video tooling, and interfaces that turn a method into something you can watch respond.',
	contacts: [
		{ label: 'iwan@ibnoulouafi.com', href: 'mailto:iwan@ibnoulouafi.com', icon: 'mail' },
		{ label: '+33 7 54 84 89 00', href: 'tel:+33754848900', icon: 'phone' },
		{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/iwan-ibnoulouafi/', icon: 'linkedin' },
		{ label: 'GitHub', href: 'https://github.com/nnnawi', icon: 'github' },
	],
	meta: [
		{ label: 'Based in', value: 'Paris, France' },
		{ label: 'Focus', value: 'Computer vision · Machine learning' },
		{ label: 'Education', value: 'MSc Computer Science, Télécom SudParis' },
		{ label: 'Languages', value: 'French (native) · English (fluent)' },
	],
};

const intro = {
	label: 'Profile',
	title: 'Engineering as a way of looking at things',
	body: [
		'Two years of French preparatory class, then five at Télécom SudParis for an MSc in computer science specialised in computer vision and machine learning. Alongside the degree I have been freelancing since 2022 — full-stack work for French SMEs, OCR and document-processing pipelines, and AI automation for teams that needed the whole thing built rather than advised on.',
		'The other half of that decade was spent in video production, editing and directing for some of the largest French YouTube channels. Cutting for a living is what turned me into a tool builder: the fastest way out of a repetitive pass was always to automate it, which is how derushing scripts, Premiere and After Effects plugins, and eventually a local anonymisation pipeline came to exist.',
		'What carries across both is a preference for work that stays visible end to end — parsing, model, shader, interface — and for shipping the thing rather than stopping at the prototype.',
	],
};

const experience = [
	{
		period: 'Summer 2025',
		duration: '6 months',
		role: 'Software Engineer Intern',
		org: 'Brio',
		place: 'Paris, France',
		points: [
			'Owned an end-to-end resume analyser from prototype to production in a team of five — document parsing, OCR, and orchestrated LLM / rule-based scoring. 20,000+ analyses run.',
			'Led a full UX/UI redesign of the interview product’s overview and extended the client-facing back office — data, access control and dashboards — as the user base grew.',
		],
	},
	{
		period: '2022 — Today',
		duration: '4 years',
		role: 'Software & Web Developer',
		org: 'Freelance',
		place: 'Paris, France',
		points: [
			'Shipped 10+ full-stack projects for French SMEs, spanning SEO-optimised websites (UI/UX, hosting, security) and AI automation tools including OCR pipelines and document-processing systems.',
		],
	},
	{
		period: 'Summer 2022',
		duration: '3 months',
		role: 'Software Engineer Intern',
		org: 'Infogene',
		place: 'Paris, France',
		points: [
			'Built a Flutter/Dart mobile app for L’Oréal employees to manage sales and stock requests, serving a target population of 500+ users.',
		],
	},
	{
		period: '2021 — 2025',
		duration: '4 years',
		role: 'Video Production',
		org: 'Freelance',
		place: 'Paris, France',
		points: [
			'Cut editorial turnaround by 15–30% for top-10 French YouTube channels (5M+ subscribers) with custom Premiere and After Effects tooling automating derushing, indexing and ingest.',
			'Delivered end-to-end production — editing, motion graphics, camera operation and direction — on content reaching 10M+ views.',
		],
	},
];

const education = [
	{
		period: '2021 — 2025',
		duration: 'MSc',
		role: 'MSc in Computer Science',
		org: 'Télécom SudParis',
		place: 'Polytechnic Institute of Paris',
		points: ['Specialisation in computer vision and machine learning.'],
	},
	{
		period: '2019 — 2021',
		duration: 'CPGE',
		role: 'Preparatory class for the Grandes Écoles',
		org: 'Lycée Marcelin Berthelot',
		place: 'Saint-Maur-des-Fossés, France',
		points: [
			'Two-year selective program in mathematics, physics and engineering, leading to the national competitive entrance examinations.',
		],
	},
];

// Grouped from the stacks the projects on this site were actually built with.
const toolbox = [
	{ label: 'Languages', items: ['TypeScript', 'Python', 'C++', 'Dart', 'WGSL'] },
	{
		label: 'Vision & ML',
		items: ['PyTorch', 'ONNX', 'TensorFlow Lite', 'YOLO', 'Quantization', 'Pruning'],
	},
	{ label: 'Graphics & GPU', items: ['WebGPU', 'CUDA', 'Metal', 'After Effects SDK', 'UXP'] },
	{ label: 'Application', items: ['Angular', 'Astro', 'Electron', 'Flutter', 'NXP i.MX 8M Plus'] },
];

const aside = [
	{ label: 'Extracurricular', value: 'Piano (15 years), Sailing, Electronic circuit design' },
	{ label: 'Working languages', value: 'French (native), English (fluent)' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={profile.tagline} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Instrument+Serif:ital@0;1&display=swap"
		/>
		<title>About — Iwan</title>
	</head>
	<body>
		<Nav active="/about" />

		<main>
			<header class="about-header">
				<p class="section__label">About me</p>
				<h1 class="about-title">
					Iwan <span class="about-title__last">Ibnoulouafi</span>
				</h1>
				<p class="about-tagline">
					Computer vision and machine learning engineer based in Paris. I build software that sits
					between an algorithm and the person using it — GPU pipelines, video tooling, and
					interfaces that turn a method into something you can <em class="t-flourish"
						>watch respond</em
					>.
				</p>

				<ul class="contact">
					{
						profile.contacts.map((item) => (
							<li>
								<a
									class="contact__link"
									href={item.href}
									target={item.href.startsWith('http') ? '_blank' : undefined}
									rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
								>
									<svg
										class="contact__icon"
										viewBox="0 0 16 16"
										aria-hidden="true"
										fill={item.icon === 'github' || item.icon === 'linkedin' ? 'currentColor' : 'none'}
										stroke={item.icon === 'github' || item.icon === 'linkedin' ? 'none' : 'currentColor'}
										stroke-width="1.3"
									>
										{item.icon === 'mail' && (
											<Fragment>
												<rect x="1.75" y="3.25" width="12.5" height="9.5" rx="1.6" />
												<path d="m2.4 4.4 5.6 4 5.6-4" />
											</Fragment>
										)}
										{item.icon === 'phone' && (
											<path d="M3.2 2.1h2.3l1.1 2.8-1.4 1a8.4 8.4 0 0 0 3.9 3.9l1-1.4 2.8 1.1v2.3a1.3 1.3 0 0 1-1.4 1.3A11.4 11.4 0 0 1 1.9 3.5 1.3 1.3 0 0 1 3.2 2.1Z" />
										)}
										{item.icon === 'linkedin' && (
											<path d="M3.1 6.2h2.3V14H3.1V6.2Zm1.15-3.6a1.35 1.35 0 1 1 0 2.7 1.35 1.35 0 0 1 0-2.7ZM7 6.2h2.2v1.06h.03c.31-.58 1.06-1.2 2.18-1.2 2.33 0 2.76 1.5 2.76 3.46V14h-2.3v-3.98c0-.95-.02-2.17-1.34-2.17-1.34 0-1.54 1.03-1.54 2.1V14H7V6.2Z" />
										)}
										{item.icon === 'github' && (
											<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
										)}
									</svg>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>

				<dl class="about-meta">
					{
						profile.meta.map((item) => (
							<div class="about-meta__row">
								<dt class="about-meta__label">{item.label}</dt>
								<dd class="about-meta__value">{item.value}</dd>
							</div>
						))
					}
				</dl>
			</header>

			<div class="prose">
				<section class="prose__section">
					<p class="section__label">{intro.label}</p>
					<div class="prose__body">
						<h2 class="prose__heading">{intro.title}</h2>
						{intro.body.map((paragraph) => <p class="prose__paragraph">{paragraph}</p>)}
					</div>
				</section>
			</div>

			<section class="entries" aria-labelledby="experience-heading">
				<h2 class="section__label section__label--heading" id="experience-heading">Experience</h2>
				<ol class="entry-list">
					{
						experience.map((item) => (
							<li class="entry">
								<div class="entry__aside">
									<p class="entry__period">{item.period}</p>
									<p class="entry__duration">{item.duration}</p>
								</div>
								<div class="entry__body">
									<h3 class="entry__role">{item.role}</h3>
									<p class="entry__org">
										{item.org}
										<span class="entry__place"> — {item.place}</span>
									</p>
									<ul class="entry__points">
										{item.points.map((point) => (
											<li class="entry__point">
												<span class="entry__bullet" aria-hidden="true" />
												<span>{point}</span>
											</li>
										))}
									</ul>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<section class="entries" aria-labelledby="education-heading">
				<h2 class="section__label section__label--heading" id="education-heading">Education</h2>
				<ol class="entry-list">
					{
						education.map((item) => (
							<li class="entry">
								<div class="entry__aside">
									<p class="entry__period">{item.period}</p>
									<p class="entry__duration">{item.duration}</p>
								</div>
								<div class="entry__body">
									<h3 class="entry__role">{item.role}</h3>
									<p class="entry__org">
										{item.org}
										<span class="entry__place"> — {item.place}</span>
									</p>
									<ul class="entry__points">
										{item.points.map((point) => (
											<li class="entry__point">
												<span class="entry__bullet" aria-hidden="true" />
												<span>{point}</span>
											</li>
										))}
									</ul>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<section class="entries" aria-labelledby="toolbox-heading">
				<h2 class="section__label section__label--heading" id="toolbox-heading">Toolbox</h2>
				<div class="toolbox">
					{
						toolbox.map((group) => (
							<div class="toolbox__group">
								<p class="toolbox__label">{group.label}</p>
								<ul class="toolbox__tags">
									{group.items.map((tag) => (
										<li class="toolbox__tag">{tag}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>

				<dl class="aside-list">
					{
						aside.map((item) => (
							<div class="aside-list__row">
								<dt class="aside-list__label">{item.label}</dt>
								<dd class="aside-list__value">{item.value}</dd>
							</div>
						))
					}
				</dl>
			</section>

			<section class="cta">
				<p class="cta__text">
					The work itself lives on the <a class="cta__link" href="/projects">projects page</a>. For
					anything else, the inbox is open.
				</p>
				<a class="cta__button" href="mailto:iwan@ibnoulouafi.com">Get in touch</a>
			</section>

			<footer class="site-footer">
				<span>Iwan Ibnoulouafi</span>
				<a href="mailto:iwan@ibnoulouafi.com">iwan@ibnoulouafi.com</a>
			</footer>
		</main>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		background: #05070c;
		color: #e8eaf0;
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-weight: 350;
	}

	main {
		max-inline-size: 1100px;
		margin-inline: auto;
		/* Extra top room so the fixed nav never sits on the page title. */
		padding: clamp(5.5rem, 12vh, 8rem) clamp(1rem, 4vw, 2rem) clamp(1.5rem, 5vw, 4rem);
	}

	/* Shared small-caps label used by every section on the page. */
	.section__label {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 350;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(232, 234, 240, 0.38);
	}

	.section__label--heading {
		margin-block-end: clamp(1.25rem, 2.5vw, 1.75rem);
	}

	/* --- Header ---------------------------------------------------------- */

	.about-header {
		margin-block-end: clamp(2rem, 5vw, 3rem);
	}

	.about-title {
		margin: clamp(0.75rem, 1.5vw, 1.15rem) 0 0;
		font-size: clamp(2.75rem, 9vw, 5.5rem);
		font-weight: 350;
		line-height: 0.98;
		letter-spacing: -0.035em;
	}

	.about-title__last {
		font-weight: 700;
		letter-spacing: -0.045em;
	}

	.about-tagline {
		margin: clamp(1rem, 2.5vw, 1.5rem) 0 0;
		max-inline-size: 52ch;
		font-size: clamp(1rem, 1.6vw, 1.2rem);
		line-height: 1.45;
		color: rgba(232, 234, 240, 0.62);
		text-wrap: pretty;
	}

	/* The one serif flourish, borrowed from the landing headline. */
	.t-flourish {
		font-family: 'Instrument Serif', Georgia, 'Times New Roman', serif;
		font-size: 1.12em;
		font-style: italic;
		font-weight: 400;
		letter-spacing: -0.01em;
		color: rgba(232, 234, 240, 0.85);
	}

	/* --- Contact pills --------------------------------------------------- */

	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: clamp(1.5rem, 3vw, 2rem) 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.85rem;
	}

	.contact__link {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.55em 1em;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.03);
		color: rgba(232, 234, 240, 0.82);
		line-height: 1;
		text-decoration: none;
		transition:
			color 160ms ease,
			border-color 160ms ease,
			background-color 160ms ease;
	}

	.contact__link:hover {
		color: #e8eaf0;
		border-color: rgba(255, 255, 255, 0.28);
		background: rgba(255, 255, 255, 0.07);
	}

	.contact__link:focus-visible {
		outline: 2px solid rgba(232, 234, 240, 0.75);
		outline-offset: 3px;
	}

	.contact__icon {
		flex: none;
		inline-size: 1.05em;
		block-size: 1.05em;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.about-meta {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
		margin: clamp(2rem, 5vw, 3.25rem) 0 0;
		padding-block-start: 1.25rem;
		border-block-start: 1px solid rgba(255, 255, 255, 0.09);
	}

	.about-meta__row {
		display: flex;
		flex-direction: column;
		gap: 0.4em;
	}

	.about-meta__label {
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(232, 234, 240, 0.38);
	}

	.about-meta__value {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.35;
		color: rgba(232, 234, 240, 0.88);
		text-wrap: pretty;
	}

	/* --- Prose ----------------------------------------------------------- */

	.prose {
		margin-block: clamp(3rem, 8vw, 5.5rem);
	}

	.prose__section {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
		gap: clamp(1rem, 3vw, 2rem);
	}

	.prose__body {
		max-inline-size: 62ch;
	}

	.prose__heading {
		margin: 0 0 0.9em;
		font-size: clamp(1.35rem, 2.6vw, 1.85rem);
		font-weight: 350;
		line-height: 1.2;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.prose__paragraph {
		margin: 0 0 1em;
		font-size: clamp(0.95rem, 1.4vw, 1.05rem);
		line-height: 1.6;
		color: rgba(232, 234, 240, 0.68);
		text-wrap: pretty;
	}

	.prose__paragraph:last-child {
		margin-block-end: 0;
	}

	/* --- Timeline entries ------------------------------------------------ */

	.entries {
		margin-block-start: clamp(3rem, 8vw, 5.5rem);
	}

	.entry-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.entry {
		display: grid;
		/* Same 1:3 rhythm as the prose sections — period on the left, role on the right. */
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
		gap: clamp(1rem, 3vw, 2rem);
		padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
		border-block-start: 1px solid rgba(255, 255, 255, 0.09);
	}

	.entry:last-child {
		border-block-end: 1px solid rgba(255, 255, 255, 0.09);
	}

	.entry__aside {
		display: flex;
		flex-direction: column;
		gap: 0.35em;
	}

	.entry__period {
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.3;
		color: rgba(232, 234, 240, 0.72);
	}

	.entry__duration {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(232, 234, 240, 0.38);
	}

	.entry__body {
		max-inline-size: 62ch;
	}

	.entry__role {
		margin: 0;
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		font-weight: 350;
		line-height: 1.25;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.entry__org {
		margin: 0.4em 0 0;
		font-size: 0.92rem;
		line-height: 1.35;
		color: rgba(232, 234, 240, 0.72);
	}

	.entry__place {
		color: rgba(232, 234, 240, 0.4);
	}

	.entry__points {
		display: flex;
		flex-direction: column;
		gap: 0.65em;
		margin: clamp(0.9rem, 2vw, 1.15rem) 0 0;
		padding: 0;
		list-style: none;
	}

	.entry__point {
		display: flex;
		align-items: flex-start;
		gap: 0.75em;
		font-size: clamp(0.92rem, 1.4vw, 1rem);
		line-height: 1.55;
		color: rgba(232, 234, 240, 0.68);
		text-wrap: pretty;
	}

	.entry__bullet {
		flex: none;
		inline-size: 5px;
		block-size: 5px;
		/* Optically centred on the first line of text. */
		margin-block-start: 0.62em;
		border-radius: 50%;
		background: rgba(232, 234, 240, 0.35);
	}

	/* --- Toolbox --------------------------------------------------------- */

	.toolbox {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		/* Each card keeps its own height rather than being stretched by the row. */
		align-items: start;
		gap: clamp(0.6rem, 1.5vw, 1rem);
	}

	.toolbox__group {
		padding: clamp(1rem, 2.2vw, 1.35rem);
		border: 1px solid rgba(255, 255, 255, 0.09);
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.02);
	}

	.toolbox__label {
		margin: 0 0 0.9em;
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(232, 234, 240, 0.38);
	}

	.toolbox__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.toolbox__tag {
		padding: 0.4em 0.8em;
		border: 1px solid rgba(255, 255, 255, 0.09);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.03);
		font-size: 0.82rem;
		line-height: 1;
		color: rgba(232, 234, 240, 0.78);
	}

	.aside-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
		margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
		padding-block-start: 1.25rem;
		border-block-start: 1px solid rgba(255, 255, 255, 0.09);
	}

