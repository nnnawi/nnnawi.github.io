---
import Aura from '../shared/aura/Aura.astro';
import Nav from '../shared/nav/Nav.astro';

// ---------------------------------------------------------------------------
// About page — a sticky identity column beside one rail carrying experience and
// then education. Résumé wording is kept verbatim in the bullets.
// Projects live on /projects, so nothing here repeats them.
// ---------------------------------------------------------------------------

const email = 'iwan@ibnoulouafi.com';

const icons: Record<string, { filled: boolean; paths: string[] }> = {
	mail: {
		filled: false,
		paths: [
			'M3.35 3.25h9.3a1.6 1.6 0 0 1 1.6 1.6v6.3a1.6 1.6 0 0 1-1.6 1.6h-9.3a1.6 1.6 0 0 1-1.6-1.6v-6.3a1.6 1.6 0 0 1 1.6-1.6Z',
			'm2.4 4.4 5.6 4 5.6-4',
		],
	},
	linkedin: {
		filled: true,
		paths: [
			'M3.1 6.2h2.3V14H3.1V6.2Zm1.15-3.6a1.35 1.35 0 1 1 0 2.7 1.35 1.35 0 0 1 0-2.7ZM7 6.2h2.2v1.06h.03c.31-.58 1.06-1.2 2.18-1.2 2.33 0 2.76 1.5 2.76 3.46V14h-2.3v-3.98c0-.95-.02-2.17-1.34-2.17-1.34 0-1.54 1.03-1.54 2.1V14H7V6.2Z',
		],
	},
	github: {
		filled: true,
		paths: [
			'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z',
		],
	},
};

const contacts = [
	{ label: email, href: `mailto:${email}`, icon: 'mail' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/iwan-i-01166a231/', icon: 'linkedin' },
	{ label: 'GitHub', href: 'https://github.com/nnnawi', icon: 'github' },
];

// Off-site links open in a new tab; mailto: stays where it is.
const external = (href: string) =>
	href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {};

const lead = 'I build interactive systems for complex computational and creative workflows.';

const intro = [
	'My work spans real-time graphics, computer vision and interaction design, focused on making technically complex systems easier to explore, control and understand through intuitive manipulation and visual feedback.',
	'I have built and sold interactive tools like BOWDE and MorphoX, designed production workflows for large-scale productions, and developed software independently as a freelancer.',
	'Alongside engineering, a decade across video production, motion design, VFX and generative visuals continues to shape how I think about interaction, aesthetics and creative flow.',
];

const education = [
	{
		period: '2021 — 2025',
		role: 'Télécom SudParis',
		org: 'Institut Polytechnique de Paris · University',
		points: ['MSc in Computer Science, specialization in Computer Vision & Machine Learning.'],
	},
	{
		period: '2019 — 2021',
		role: 'Lycée Marcelin Berthelot',
		org: 'Preparatory class for the Grandes écoles',
		points: [
			'Two-year selective program in mathematics, physics and engineering leading to national competitive entrance examinations.',
		],
	},
];

const experience = [
	{
		period: 'Jun — Dec 2025 · 6 months',
		role: 'Software Engineer Intern',
		org: 'Brio · Paris, France',
		points: [
			'Owned the company’s second product, a resume analyser, from prototype to production within a five-person team: document parsing, OCR, orchestrated LLM workflows and rule-based scoring. Processed **20,000+ analyses** at ~20 s and under $0.05 per CV, with ~85% agreement against 40+ hand-labelled resumes.',
			'Built a platform-wide LLM observability layer using Langfuse tracing and PostHog analytics, **roughly halving debugging time** by pinpointing faulty prompts and pipeline stages.',
		],
	},
	{
		period: '2023 — Today · 3 years',
		role: 'Software & Web Developer',
		org: 'Freelance · Paris, France',
		points: [
			'Designed and refactored backends for multiple client products, improving scalability and performance; **halved search latency** for an AI semantic-search engine through optimised embedding retrieval, distance computation, caching and batched parallel LLM API calls.',
			'Developed a financial dashboard for a video production company, integrating a custom receipt and invoice scanner to generate per-project cost tables reconciled against bank statements. Reduced reconciliation errors to **near zero** and processing time by **3×**.',
			'Delivered **10+ projects** for French SMEs, spanning SEO-optimised websites and AI automations for document parsing, data extraction, visualisation and workflow organisation.',
		],
	},
	{
		period: '2022 — 2025 · 3 years',
		role: 'Video Production',
		org: 'Freelance · Paris, France',
		points: [
			'Saved **~2 hours per 10-hour edit** for top-10 French YouTube channels (5M+ subscribers) through Python and JavaScript automation for Premiere Pro and After Effects, including footage grouping, action-moment isolation and programmable HUD animations.',
			'Handled end-to-end video production across editing, motion graphics, camera operation and direction for content reaching **10M+ views**.',
		],
	},
	{
		period: 'Jun — Aug 2022 · 3 months',
		role: 'Software Engineer Intern',
		org: 'Infogene · Paris, France',
		points: [
			'Shipped a Flutter/Dart application for **500+ L’Oréal employees** to manage sales and stock requests, backed by a Symfony/PHP API.',
		],
	},
];

// Bullets mark résumé highlights with **…**; split them into plain and bold runs.
const emphasis = (point: string) =>
	point.split(/\*\*(.+?)\*\*/).map((text, i) => ({ text, bold: i % 2 === 1 }));

const interests = [
	'Piano · 15 years',
	'Sailing',
	'Electronic circuit design',
	'3D printing & modeling',
	'Microcontrollers & robotics',
];
const software = ['After Effects', 'Premiere Pro', 'Fusion 360'];
const languages = 'French (native) · English (fluent)';

const sections = [
	{ id: 'experience', title: 'Experience', items: experience },
	{ id: 'education', title: 'Education', items: education },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={lead} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Geist+Pixel&family=Inter:wght@100..900&display=swap"
		/>
		<title>About — Iwan</title>
	</head>
	<body>
		<Aura />

		<Nav active="/about" />

		<main class="about">
			<div class="wrap layout">
				<aside class="identity">
					<h1 class="name reveal">
						<span class="name__first">Iwan</span>
						<span class="name__last">Ibnoulouafi</span>
					</h1>

					<ul class="pills reveal" style="--d: 100ms">
						{
							contacts.map((item) => (
								<li>
									<a class="pill" href={item.href} {...external(item.href)}>
										<svg
											class="pill__icon"
											viewBox="0 0 16 16"
											aria-hidden="true"
											fill={icons[item.icon].filled ? 'currentColor' : 'none'}
											stroke={icons[item.icon].filled ? 'none' : 'currentColor'}
											stroke-width="1.3"
										>
											{icons[item.icon].paths.map((d) => (
												<path d={d} />
											))}
										</svg>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>

					<div class="facts reveal" style="--d: 180ms">
						<div>
							<p class="label">Languages</p>
							<p class="facts__value">{languages}</p>
						</div>
						<div>
							<p class="label">Off screen</p>
							<ul class="chips">
								{interests.map((item) => <li class="chip">{item}</li>)}
							</ul>
						</div>
			
					</div>
				</aside>

				<div class="main">
					<section class="intro">
						<p class="intro__lead reveal">{lead}</p>
						{intro.map((paragraph) => <p class="intro__text reveal">{paragraph}</p>)}
					</section>

					{
						sections.map((section) => (
							<section class="chapter" aria-labelledby={section.id}>
								<h2 class="chapter__title" id={section.id}>
									{section.title}
								</h2>
								<div class="rail">
									{section.items.map((item) => (
										<article class="entry reveal">
											<p class="entry__period pixel">{item.period}</p>
											<h3 class="entry__role">{item.role}</h3>
											<p class="entry__org">{item.org}</p>
											<ul class="points">
												{item.points.map((point) => (
													<li class="points__item">
														<span class="points__dot" aria-hidden="true" />
														<span>
															{emphasis(point).map(({ text, bold }) => (bold ? <strong>{text}</strong> : text))}
														</span>
													</li>
												))}
											</ul>
										</article>
									))}
								</div>
							</section>
						))
					}

		
				</div>
			</div>

			<div class="wrap">
				<footer class="site-footer">
					
				</footer>
			</div>
		</main>

		<script is:inline>
			// Blocks rise into place as they enter the viewport.
			if (
				!window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
				'IntersectionObserver' in window
			) {
				document.documentElement.classList.add('reveal-ready');
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add('is-in');
							observer.unobserve(entry.target);
						}
					},
					{ threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
				);
				for (const el of document.querySelectorAll('.reveal')) observer.observe(el);
			}
		</script>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		background: #000;
		color: #e8eaf0;
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-weight: 350;
	}

	/* --- Aura background -------------------------------------------------- */

	/* Opacity of the dithered photo. Its dots are pure, full-strength colours,
	   so this is what keeps them a texture under the muted copy rather than
	   competing with it, lower still once the column fills the window and there
	   is no empty gutter left. */
	:global(body) {
		--aura-intensity: 0.3;
	}

	@media (max-width: 1300px) {
		:global(body) {
			--aura-intensity: 0.26;
		}
	}

	@media (max-width: 1000px) {
		:global(body) {
			--aura-intensity: 0.22;
		}
	}

	.about {
		--fg: #e8eaf0;
		--muted: rgba(232, 234, 240, 0.64);
		--faint: rgba(232, 234, 240, 0.4);
		--pixel: 'Geist Pixel', 'Geist Mono', ui-monospace, monospace;
		/* Where the fixed nav ends, and where the page can start under it. */
		--chrome-bottom: calc(clamp(1rem, 2.5vh, 1.75rem) + 3.2rem);

		padding-block-start: calc(var(--chrome-bottom) + clamp(2rem, 6vh, 4rem));
		overflow-x: clip;
	}

	.wrap {
		max-inline-size: 1100px;
		margin-inline: auto;
		padding-inline: clamp(1rem, 4vw, 2rem);
	}

	.pixel {
		font-family: var(--pixel);
		font-weight: 400;
		/* A bitmap face needs air between glyphs, not the tightening a serif takes. */
		letter-spacing: 0.01em;
	}

	.label {
		margin: 0 0 0.6rem;
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--faint);
	}

	/* --- Layout ----------------------------------------------------------- */

	.layout {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
	}

	.identity {
		position: sticky;
		inset-block-start: calc(var(--chrome-bottom) + 1.5rem);
		display: flex;
		flex-direction: column;
		gap: clamp(1.5rem, 3.5vh, 2.25rem);
	}

	.name {
		display: flex;
		flex-direction: column;
		margin: 0;
		font-size: clamp(2.75rem, 5.6vw, 4.85rem);
		line-height: 0.9;
		letter-spacing: -0.05em;
	}

	.name__first,
	.name__last {
		font-weight: 700;
	}

	/* --- Contact pills ---------------------------------------------------- */

	.pills {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.85rem;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.6em 1.05em;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.035);
		color: rgba(232, 234, 240, 0.85);
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
		transition:
			color 160ms ease,
			border-color 160ms ease,
			background-color 160ms ease;
	}

	.pill:hover {
		color: #fff;
		border-color: rgba(255, 255, 255, 0.34);
		background: rgba(255, 255, 255, 0.08);
	}

	.pill__icon {
		flex: none;
		inline-size: 1.05em;
		block-size: 1.05em;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.pill:focus-visible,
	.btn:focus-visible {
		outline: 2px solid rgba(232, 234, 240, 0.75);
		outline-offset: 3px;
	}

	/* --- Facts ------------------------------------------------------------ */

	.facts {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.facts__value {
		margin: 0;
		font-size: 0.95rem;
		color: var(--fg);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.chip {
		padding: 0.55em 1em;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.035);
		font-size: 0.88rem;
		line-height: 1;
		color: rgba(232, 234, 240, 0.85);
		white-space: nowrap;
	}

	/* --- Intro ------------------------------------------------------------ */

	.intro__lead {
		margin: 0 0 1.25rem;
		font-size: clamp(1.35rem, 2.4vw, 1.75rem);
		line-height: 1.3;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.intro__text {
		margin: 0 0 1em;
		font-size: clamp(0.95rem, 1.4vw, 1.05rem);
		line-height: 1.65;
		color: var(--muted);
		text-wrap: pretty;
	}

	.intro__text:last-child {
		margin-block-end: 0;
	}

	/* --- Chapters and rail ------------------------------------------------ */

	.chapter {
		margin-block-start: clamp(3.5rem, 8vw, 5.5rem);
	}

	.chapter__title {
		margin: 0 0 clamp(1.25rem, 3vw, 1.75rem);
		font-size: clamp(1.75rem, 3.4vw, 2.6rem);
		font-weight: 350;
		line-height: 1;
		letter-spacing: -0.045em;
	}

	.rail {
		--rail-x: 0.45rem;
		--rail-pad: clamp(1.75rem, 4vw, 2.5rem);

		position: relative;
		padding-inline-start: var(--rail-pad);
	}

	/* The only line in this column: a beam fading out as the entries run down. */
	.rail::before {
		content: '';
		position: absolute;
		inset-block: 1.6rem 0.5rem;
		inset-inline-start: var(--rail-x);
		inline-size: 1px;
		background: linear-gradient(
			to bottom,
			rgba(232, 234, 240, 0.55) 0%,
			rgba(232, 234, 240, 0.3) 40%,
			rgba(232, 234, 240, 0.22) 78%,
			rgba(232, 234, 240, 0) 100%
		);
	}

	.entry {
		position: relative;
		margin-block-end: 0.75rem;
		padding: clamp(1.15rem, 2.5vw, 1.6rem);
		border-radius: 18px;
		/* Frosted and darkened, so the dithered background behind it turns into
		   a soft, dim wash instead of dots competing with the text. A hairline
		   inner edge keeps the card's outline without adding brightness. */
		background: rgba(0, 0, 0, 0.3);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(2px);
		transition: background-color 300ms ease;
	}

	/* Node sitting on the rail, level with the entry's first line. */
	.entry::before {
		content: '';
		position: absolute;
		inset-block-start: 1.7rem;
		inset-inline-start: calc(var(--rail-x) - var(--rail-pad) - 4.5px);
		inline-size: 9px;
		block-size: 9px;
		border-radius: 50%;
		background: var(--fg);
		box-shadow:
			-1.5px 0 0 rgba(255, 47, 77, 0.55),
			1.5px 0 0 rgba(33, 228, 255, 0.5);
	}

	.entry__period {
		margin: 0;
		font-size: 1rem;
		line-height: 1.1;
		color: var(--faint);
	}

	.entry__role {
		margin: 0.7rem 0 0;
		font-size: clamp(1.2rem, 2vw, 1.45rem);
		font-weight: 350;
		line-height: 1.2;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.entry__org {
		margin: 0.35em 0 0;
		font-size: 0.9rem;
		color: var(--faint);
	}

	.points {
		display: flex;
		flex-direction: column;
		gap: 0.6em;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	.points__item {
		display: flex;
		align-items: flex-start;
		gap: 0.75em;
		font-size: clamp(0.92rem, 1.3vw, 1rem);
		line-height: 1.55;
		color: var(--muted);
		text-wrap: pretty;
	}

	.points__item strong {
		font-weight: 550;
		color: var(--fg);
	}

	.points__dot {
		flex: none;
		inline-size: 5px;
		block-size: 5px;
		/* Optically centred on the first line of text. */
		margin-block-start: 0.62em;
		border-radius: 50%;
		background: rgba(232, 234, 240, 0.45);
	}

	/* --- Closing note ----------------------------------------------------- */

	.cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		margin-block-start: clamp(3rem, 7vw, 4.5rem);
		padding-inline-start: clamp(1.75rem, 4vw, 2.5rem);
	}

	.cta__title {
		margin: 0;
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		letter-spacing: -0.035em;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.8em 1.35em;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.94);
		color: #05070c;
		font-size: 0.9rem;
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
		transition:
			background-color 160ms ease,
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.btn:hover {
		background: #fff;
		transform: translateY(-2px);
	}

	/* --- Footer ----------------------------------------------------------- */

	.site-footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		margin-block-start: clamp(4rem, 10vw, 7rem);
		padding-block: 1.25rem clamp(1.5rem, 4vw, 2.5rem);
		border-block-start: 1px solid rgba(255, 255, 255, 0.09);
		font-size: 0.85rem;
		color: rgba(232, 234, 240, 0.45);
	}

	.site-footer a {
		color: inherit;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.site-footer a:hover {
		color: rgba(232, 234, 240, 0.9);
	}

	/* Blocks rise into place once the script confirms motion is welcome. */
	:global(html.reveal-ready) .reveal {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 800ms cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms),
			transform 800ms cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms);
	}

	:global(html.reveal-ready) .reveal.is-in {
		opacity: 1;
		transform: none;
	}

	/* --- Responsive ------------------------------------------------------- */

	@media (max-width: 900px) {
		.layout {
			grid-template-columns: minmax(0, 1fr);
		}

		.identity {
			position: static;
		}

		.pills {
			flex-direction: row;
			flex-wrap: wrap;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pill,
		.btn,
		.entry,
		.site-footer a {
			transition: none;
		}

		.btn:hover {
			transform: none;
		}
	}
</style>
