---
// ---------------------------------------------------------------------------
// Annex — five iterations of the Repel interaction on the chosen headline
// (option 03, Retype, from /annex). Each row carries its own copy of the line
// and its own tuning. Not linked from the nav; delete once one is picked.
// ---------------------------------------------------------------------------

const words = ['creative', 'computer vision', 'software'];
const interval = 3000;

// Read by screen readers in place of the animated line.
const spoken = 'I’m Iwan, a creative, computer vision and software engineer building the tools I wish I had.';

const options = [
	{
		id: 'push',
		name: 'Push',
		note: 'The baseline. Letters are nudged away from the cursor with a slight tilt, and spring back when it leaves. The rotating word moves as one block.',
	},
	{
		id: 'words',
		name: 'Word blocks',
		note: 'Whole words are pushed instead of letters, over a wider radius and a shorter distance. Calmer, and the sentence stays readable while it moves.',
	},
	{
		id: 'sweep',
		name: 'Sweep',
		note: 'Driven by cursor speed, not position. A slow cursor barely disturbs the line; a fast swipe scatters letters along its path, and they drift back once it slows.',
	},
	{
		id: 'chroma',
		name: 'Chromatic push',
		note: 'The Push motion, with a red/cyan split that grows with each letter’s displacement — the same fringe as the nodes on the About rail.',
	},
	{
		id: 'void',
		name: 'Void',
		note: 'Letters shrink and fade as they are pushed out, opening a clearing around the cursor that closes again behind it.',
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Geist+Pixel&family=Inter:wght@100..900&display=swap"
		/>
		<title>Repel iterations — Iwan</title>
	</head>
	<body>
		<main class="annex">
			<header class="wrap intro">
				<a class="intro__back" href="/annex">← Title options</a>
				<p class="label pixel">Annex</p>
				<h1 class="intro__title">Repel — five iterations</h1>
				<p class="intro__text">
					All five use the Retype headline. Move the cursor over each line to try it. These are
					mouse-only and switched off with reduced motion; otherwise the line stays as it is.
				</p>
			</header>

			{
				options.map((option, i) => (
					<section class="wrap option" data-interaction={option.id}>
						<div class="option__meta">
							<p class="option__num pixel">{String(i + 1).padStart(2, '0')}</p>
							<h2 class="option__name">{option.name}</h2>
							<p class="option__note">{option.note}</p>
						</div>
						<div class="option__stage">
							<p class="sr-only">{spoken}</p>
							<p class={`headline headline--${option.id}`} aria-hidden="true">
								I’m Iwan, a&nbsp;<span class="type"
									><span class="type__text">creative</span><span class="type__caret" /></span
								>
								engineer building the tools I&nbsp;wish I&nbsp;had.
							</p>
						</div>
					</section>
				))
			}
		</main>

		<script is:inline define:vars={{ words, interval }}>
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

			// --- Retype -----------------------------------------------------------

			// Select the word, then type the new one over it.
			async function retype(slot, word) {
				const text = slot.querySelector('.type__text');
				if (reduce) {
					text.textContent = word;
					return;
				}
				slot.classList.add('is-selected');
				await wait(480);
				slot.classList.replace('is-selected', 'is-typing');
				text.textContent = '';
				for (const ch of word) {
					await wait(45 + Math.random() * 55);
					text.textContent += ch;
				}
				slot.classList.remove('is-typing');
			}

			const slots = [...document.querySelectorAll('.type')];
			let index = 0;

			setInterval(() => {
				if (document.hidden) return;
				index = (index + 1) % words.length;
				for (const slot of slots) retype(slot, words[index]);
			}, interval);

			// --- Helpers ----------------------------------------------------------

			// Wraps each letter of the headline's own text (not the rotating word)
			// in a span, grouped by word so lines still only break between words.
			function split(headline) {
				for (const node of [...headline.childNodes]) {
					if (node.nodeType !== Node.TEXT_NODE) continue;
					const fragment = document.createDocumentFragment();
					for (const part of node.textContent.split(/(\s+)/)) {
						if (!part) continue;
						if (/^\s+$/.test(part)) {
							fragment.append(part);
							continue;
						}
						const word = document.createElement('span');
						word.className = 'w';
						for (const ch of part) {
							const letter = document.createElement('span');
							letter.className = 'ch';
							letter.textContent = ch;
							word.append(letter);
						}
						fragment.append(word);
					}
					node.replaceWith(fragment);
				}
			}

			// A springy 0→1 influence per target, from its distance to the cursor,
			// plus the unit direction pointing away from it. `apply` turns that
			// into a style. With `sweep`, the influence scales with cursor speed and
			// the direction leans along the cursor's path.
			function repel(root, targets, options, apply) {
				const { radius: radiusEm, stiffness = 0.14, damping = 0.74, sweep = false } = options;
				const headline = root.querySelector('.headline');
				const state = targets.map(() => ({ x: 0, v: 0, dx: 0, dy: -1 }));
				const motion = { x: 0, y: 0, speed: 0, time: 0 };
				let pointer = null;
				let frame = 0;

				const tick = () => {
					const radius = radiusEm * parseFloat(getComputedStyle(headline).fontSize);
					// offsetLeft/Top ignore transforms, so these are resting positions.
					const centres = targets.map((t) => [
						t.offsetLeft + t.offsetWidth / 2,
						t.offsetTop + t.offsetHeight / 2,
					]);
					if (sweep) motion.speed *= 0.9;
					const energy = sweep ? Math.min(1, motion.speed / 1.2) : 1;
					let moving = sweep && motion.speed > 0.01;

					targets.forEach((target, i) => {
						const s = state[i];
						let goal = 0;
						if (pointer) {
							const dx = centres[i][0] - pointer.x;
							const dy = centres[i][1] - pointer.y;
							const distance = Math.hypot(dx, dy) || 1;
							const t = Math.max(0, 1 - distance / radius);
							goal = t * t * (3 - 2 * t) * energy;
							if (goal > 0.01) {
								let ux = dx / distance;
								let uy = dy / distance;
								if (sweep) {
									ux = ux * 0.5 + motion.x;
									uy = uy * 0.5 + motion.y;
									const length = Math.hypot(ux, uy) || 1;
									ux /= length;
									uy /= length;
								}
								s.dx = ux;
								s.dy = uy;
							}
						}
						s.v = (s.v + (goal - s.x) * stiffness) * damping;
						s.x += s.v;
						if (Math.abs(s.v) > 0.0005 || Math.abs(goal - s.x) > 0.001) moving = true;
						apply(target, Math.max(0, s.x), s);
					});
					frame = moving ? requestAnimationFrame(tick) : 0;
				};

				const start = () => {
					if (!frame) frame = requestAnimationFrame(tick);
				};

				root.addEventListener('pointermove', (event) => {
					if (event.pointerType !== 'mouse') return;
					const box = headline.getBoundingClientRect();
					const x = event.clientX - box.left;
					const y = event.clientY - box.top;
					if (sweep && pointer) {
						const dt = Math.max(1, event.timeStamp - motion.time);
						const step = Math.hypot(x - pointer.x, y - pointer.y) || 1;
						motion.x = (x - pointer.x) / step;
						motion.y = (y - pointer.y) / step;
						motion.speed += (step / dt - motion.speed) * 0.5;
					}
					motion.time = event.timeStamp;
					pointer = { x, y };
					start();
				});

				root.addEventListener('pointerleave', () => {
					pointer = null;
					start();
				});
			}

			// Builds the targets for one row: every letter, or every word, plus the
			// rotating word as a single block.
			function setup(id, { unit = 'letter', ...options }, apply) {
				const root = document.querySelector(`[data-interaction="${id}"]`);
				const headline = root.querySelector('.headline');
				split(headline);
				const pieces = [...headline.querySelectorAll(unit === 'word' ? '.w' : '.ch')];
				repel(root, [...pieces, headline.querySelector('.type')], options, apply);
			}

			const reset = (target) => {
				target.style.transform = '';
				target.style.textShadow = '';
				target.style.opacity = '';
			};

			// --- Rows -------------------------------------------------------------

			if (!reduce) {
				// 01 — the baseline from the previous annex.
				setup('push', { radius: 1.6 }, (target, amount, s) => {
					if (amount < 0.001) return reset(target);
					const push = amount * 0.38;
					target.style.transform = `translate(${s.dx * push}em, ${s.dy * push}em) rotate(${s.dx * amount * 10}deg)`;
				});

				// 02 — words as units: wider reach, shorter travel, barely any tilt.
				setup('words', { unit: 'word', radius: 2.4, stiffness: 0.1, damping: 0.8 }, (target, amount, s) => {
					if (amount < 0.001) return reset(target);
					const push = amount * 0.22;
					target.style.transform = `translate(${s.dx * push}em, ${s.dy * push}em) rotate(${s.dx * amount * 3}deg)`;
				});

				// 03 — speed-driven, loose spring so letters drift home.
				setup(
					'sweep',
					{ radius: 1.4, stiffness: 0.06, damping: 0.86, sweep: true },
					(target, amount, s) => {
						if (amount < 0.001) return reset(target);
						const push = amount * 0.7;
						target.style.transform = `translate(${s.dx * push}em, ${s.dy * push}em) rotate(${s.dx * amount * 28}deg)`;
					}
				);

				// 04 — Push, with an RGB split proportional to displacement.
				setup('chroma', { radius: 1.6 }, (target, amount, s) => {
					if (amount < 0.001) return reset(target);
					const push = amount * 0.38;
					const fringe = amount * 0.08;
					target.style.transform = `translate(${s.dx * push}em, ${s.dy * push}em) rotate(${s.dx * amount * 6}deg)`;
					target.style.textShadow = `${-fringe}em 0 rgba(255, 47, 77, ${amount}), ${fringe}em 0 rgba(33, 228, 255, ${amount})`;
				});

				// 05 — shrink and fade outward, opening a hole around the cursor.
				setup('void', { radius: 1.3, stiffness: 0.18, damping: 0.7 }, (target, amount, s) => {
					if (amount < 0.001) return reset(target);
					const push = amount * 0.3;
					target.style.transform = `translate(${s.dx * push}em, ${s.dy * push}em) scale(${1 - amount * 0.7})`;
					target.style.opacity = String(1 - amount * 0.6);
				});
			}
		</script>
	</body>
</html>

<!-- Global: the script builds letter spans at runtime, which scoped styles
     would never reach. This stylesheet only ships with this page. -->
<style is:global>
	body {
		--ink: #f2f3f5;
		--muted: rgba(242, 243, 245, 0.5);
		--faint: rgba(242, 243, 245, 0.38);
		--rule: rgba(242, 243, 245, 0.12);
		--pixel: 'Geist Pixel', 'Geist Mono', ui-monospace, monospace;

		margin: 0;
		background: #000;
		color: var(--ink);
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-weight: 350;
	}

	.wrap {
		max-inline-size: 1400px;
		margin-inline: auto;
		padding-inline: clamp(1rem, 4vw, 3rem);
	}

	.pixel {
		font-family: var(--pixel);
		font-weight: 400;
		letter-spacing: 0.01em;
	}

	.label {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.sr-only {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* --- Intro ------------------------------------------------------------ */

	.intro {
		display: grid;
		gap: 1rem;
		justify-items: start;
		padding-block: clamp(3rem, 10vh, 6rem) clamp(2.5rem, 6vh, 4rem);
	}

	.intro__back {
		margin-block-end: 1rem;
		color: var(--faint);
		font-size: 0.85rem;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.intro__back:hover {
		color: var(--ink);
	}

	.intro__title {
		margin: 0;
		font-size: clamp(1.9rem, 3.6vw, 3rem);
		font-weight: 350;
		line-height: 1.05;
		letter-spacing: -0.045em;
	}

	.intro__text {
		max-inline-size: 38rem;
		margin: 0;
		color: var(--muted);
		line-height: 1.6;
	}

	/* --- Option rows ------------------------------------------------------ */

	.option {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: center;
		min-block-size: 62vh;
		padding-block: clamp(3rem, 8vh, 5rem);
		border-block-start: 1px solid var(--rule);
	}

	.option__meta {
		display: grid;
		gap: 0.6rem;
		align-self: start;
		max-inline-size: 24rem;
	}

	.option__num {
		margin: 0;
		font-size: 1rem;
		color: var(--faint);
	}

	.option__name {
		margin: 0;
		font-size: clamp(1.3rem, 2vw, 1.6rem);
		font-weight: 400;
		letter-spacing: -0.03em;
	}

	.option__note {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--muted);
		text-wrap: pretty;
	}

	.option__stage {
		justify-self: end;
		max-inline-size: min(44vw, 46rem);
	}

	/* --- Retype headline (option 03 from /annex) -------------------------- */

	.headline {
		/* The offset parent for the positions the script reads. */
		position: relative;
		margin: 0;
		color: var(--muted);
		font-size: clamp(2rem, 4.1vw, 4.8rem);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	/* A box of its own, so the rotating word can move as one block. */
	.type {
		display: inline-block;
		white-space: nowrap;
		color: var(--ink);
		font-weight: 600;
	}

	.type.is-selected .type__text {
		background: var(--ink);
		color: #000;
	}

	.type__caret {
		display: inline-block;
		inline-size: max(2px, 0.05em);
		block-size: 0.9em;
		margin-inline-start: 0.05em;
		vertical-align: -0.1em;
		background: var(--ink);
		animation: blink 1s steps(1) infinite;
	}

	.type.is-typing .type__caret {
		animation: none;
	}

	.type.is-selected .type__caret {
		visibility: hidden;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	/* --- Repel pieces ----------------------------------------------------- */

	/* Letters split out by the script. Words stay unbreakable. */
	.w {
		white-space: nowrap;
	}

	.ch,
	.headline--words .w {
		display: inline-block;
		will-change: transform;
	}

	.type {
		will-change: transform;
	}

	/* --- Responsive ------------------------------------------------------- */

	@media (max-width: 900px) {
		.option {
			grid-template-columns: minmax(0, 1fr);
			min-block-size: 0;
		}

		.option__stage {
			justify-self: center;
			max-inline-size: 36rem;
			text-align: center;
		}

		.headline {
			font-size: clamp(1.9rem, 8vw, 3.4rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.intro__back {
			transition: none;
		}

		.type__caret {
			animation: none;
		}
	}
</style>
