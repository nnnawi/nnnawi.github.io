	/* --- Pipeline graph --------------------------------------------------- */

	/* A flow diagram in plain HTML rather than SVG, so the labels stay real text
	   and stay legible when the graph is squeezed. Stacked top to bottom below
	   1000px, left to right above it — six node columns need the width, so tablets
	   in portrait keep the stack. */
	.flow {
		--line: rgba(232, 234, 240, 0.22);
		--gap: 0.65rem;
		margin-block-start: clamp(3rem, 8vw, 5.5rem);
	}

	.flow__graph {
