		text-wrap: pretty;
	}

	/* Connectors. Stacked, each is a 1px line with a chevron at its foot; the
	   segments inside only come into play once the graph turns horizontal. */
	.flow__k {
		position: relative;
		display: block;
		inline-size: 1px;
		block-size: 1.4rem;
		margin-inline: auto;
		background: var(--line);
	}

	.flow__k::after {
		content: '';
		position: absolute;
		inset-block-end: 0;
		left: 50%;
		inline-size: 5px;
		block-size: 5px;
		border-inline-end: 1px solid var(--line);
		border-block-end: 1px solid var(--line);
		transform: translate(-50%, 1px) rotate(45deg);
	}

	/* The bypass is a horizontal-only idea: stacked, EdgeTAM says it in words. */
	.flow__bar,
	.flow__leg,
	.flow__stub,
	.flow__k--bypass {
		display: none;
	}

	@media (min-width: 1000px) {
		/* Eleven columns: six for nodes, five for the connectors between them.
		   Three equal rows, one per detector. */
		.flow__graph {
			display: grid;
			grid-template-columns:
				minmax(0, 1fr) 1.4rem minmax(0, 1fr) 1.75rem minmax(0, 1fr) 1.75rem
				minmax(0, 1fr) 1.75rem minmax(0, 1fr) 1.4rem minmax(0, 1fr);
			grid-template-rows: repeat(3, minmax(0, 1fr));
			grid-template-areas:
				'src k1 dsc k2 b1 k3  .   .   msk k5 pre'
				'src k1 dsc k2 b2 k3  bt  mrg msk k5 pre'
				'src k1 dsc k2 b3 byp byp mrg msk k5 pre';
			column-gap: 0;
		}

		.flow__node {
			max-inline-size: none;
			margin-inline: 0;
			padding: clamp(0.7rem, 1.2vw, 0.9rem) clamp(0.5rem, 0.9vw, 0.8rem);
		}

		/* Everything on the spine centres on the middle row. */
		.flow__node--src,
		.flow__node--downscale,
		.flow__node--bytetrack,
		.flow__node--masks,
		.flow__node--effect {
			align-self: center;
		}

		.flow__node--src { grid-area: src; }
		.flow__node--downscale { grid-area: dsc; }
		.flow__node--b1 { grid-area: b1; }
		.flow__node--b2 { grid-area: b2; }
		.flow__node--b3 { grid-area: b3; }
		.flow__node--bytetrack { grid-area: bt; }
		.flow__node--masks { grid-area: msk; }
		.flow__node--effect { grid-area: pre; }

		.flow__k--in { grid-area: k1; }
		.flow__k--fan { grid-area: k2; }
		.flow__k--join { grid-area: k3; }
		.flow__k--bypass { grid-area: byp; }
		.flow__k--merge { grid-area: mrg; }
		.flow__k--out { grid-area: k5; }

		/* The connector stops being a line and becomes a box to draw one in.
		   --r1/--r3 are the outer row centres measured inside a full-height cell,
		   --a/--b the two row centres inside a cell spanning two rows. */
		.flow__k {
			--r1: calc((100% - 2 * var(--gap)) / 6);
			--r3: calc(100% - (100% - 2 * var(--gap)) / 6);
			--a: calc((100% - var(--gap)) / 4);
			--b: calc(100% - (100% - var(--gap)) / 4);
			--y: 50%;
			inline-size: auto;
			block-size: auto;
			margin-inline: 0;
			background: none;
		}

		.flow__bar,
		.flow__leg,
		.flow__stub,
		.flow__k--bypass {
			display: block;
		}

		.flow__bar,
		.flow__leg,
		.flow__stub {
			position: absolute;
			background: var(--line);
		}

		/* The through-line every connector carries, at its own height. */
		.flow__k::before {
			content: '';
			position: absolute;
			inset-inline: 0;
			top: var(--y);
			block-size: 1px;
			background: var(--line);
		}

		/* Chevrons turn to point along the flow. */
		.flow__k::after,
		.flow__leg::after {
			content: '';
			position: absolute;
			inset-block-end: auto;
			inset-inline-end: 0;
			left: auto;
			top: var(--y);
			inline-size: 5px;
			block-size: 5px;
			border-block-end: none;
			border-block-start: 1px solid var(--line);
			border-inline-end: 1px solid var(--line);
			transform: translate(1px, -50%) rotate(45deg);
		}

		/* Fan-out: in at the middle row, out to all three. */
		.flow__k--fan .flow__bar {
			left: 50%;
			inline-size: 1px;
			top: var(--r1);
			bottom: var(--r1);
		}

		.flow__k--fan .flow__leg {
			left: 50%;
			right: 0;
			block-size: 1px;
		}

		.flow__k--fan .flow__leg--up { top: var(--r1); }
		.flow__k--fan .flow__leg--down { top: var(--r3); }
		.flow__leg::after { --y: 50%; }

		/* Two in, one out. The join runs through on its lower row (the tracker),
		   the merge on its upper row (the masks). */
		.flow__k--join { --y: var(--b); }
		.flow__k--join .flow__stub { top: var(--a); }
		.flow__k--merge { --y: var(--a); }
		.flow__k--merge .flow__stub { top: var(--b); }

		.flow__k--join .flow__stub,
		.flow__k--merge .flow__stub {
			left: 0;
			inline-size: 50%;
			block-size: 1px;
		}

		.flow__k--join .flow__bar,
		.flow__k--merge .flow__bar {
			left: 50%;
			inline-size: 1px;
			top: var(--a);
			bottom: var(--a);
		}

		/* The bypass carries straight on under the tracker, so no arrowhead. */
		.flow__k--bypass::after {
			display: none;
		}
	}

