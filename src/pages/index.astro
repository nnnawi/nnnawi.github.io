---
import Cascade from '../shared/cascade/Cascade.astro';
import Nav from '../shared/nav/Nav.astro';

// The clips that drift through the cascade behind the headline. Hovering one
// retypes the headline into its title, with the description beneath.
const projects = [
	{
		title: 'MorphoX',
		description: 'A GPU-accelerated computer vision sandbox.',
		video: '/project_animation/MorphoX_animation.mp4',
		href: '/morphox',
	},
	{
		title: 'Vectorfield Pathfinding',
		description: 'An interactive deep dive into crowd navigation by flow field.',
		video: '/project_animation/VFP_animation.mp4',
		href: '/vectorfield-pathfinding',
	},
	{
		title: 'Dither Plugin',
		description: 'A professional-grade dithering plugin for After Effects.',
		video: '/project_animation/DitherPlugin5_animation.mp4',
		href: '/dither-plugin',
	},
	{
		title: 'Privacy Plugin',
		description: 'Automatic PII anonymisation inside Premiere Pro.',
		video: '/project_animation/PPlugin3_animation.mp4',
		href: '/privacy-plugin',
	},
	{
		title: 'YOLO on NPU',
		description: 'Compressing a detector to run on embedded hardware.',
		video: '/project_animation/NPU2_animation.mp4',
		href: '/yolo-npu',
	},
	{
		title: 'Bowde',
		description: 'An interactive control-theory plotter.',
		video: '/project_animation/BOWDE_animation.mp4',
		href: '/bowde',
	},
	{
		title: 'Image2Complex',
		description: 'A visualizer for complex functions through images.',
		video: '/project_animation/Image2Complex_animation.mp4',
		href: 'https://nnnawi.github.io/Image2complex/',
	},
	{
		title: 'SirAMP',
		description: 'A handcrafted portable bass amp.',
		video: '/project_animation/SIRAMP_animation.mp4',
		href: '/siramp',
	},
];

const descriptions = Object.fromEntries(projects.map((project) => [project.title, project.description]));

// The role in the headline, retyped in turn. The first is the default: the
// page opens on it, and the sentence always comes back with it.
const roles = ['computer vision', 'creative', 'software'];
const longestRole = roles.reduce((a, b) => (b.length > a.length ? b : a));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Iwan — creative engineer building software where art, technology and curiosity meet."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
		/>
		<title>Iwan — Creative engineer</title>
	</head>
	<body>
		<Nav active="/" />

		<main class="stage">
			<Cascade items={projects} />

			<!-- No wordmark: a sentence carries the page. The role in it is retyped
			     every few seconds, the words part around the cursor, and hovering a
			     card retypes the whole line into that project. -->
			<div class="hero">
				<div class="hero__body">
					<div class="hero__morph" data-morph={JSON.stringify(descriptions)}>
						<!-- Holds the block at the sentence's tallest, link included, so
						     the hero never recentres while the layers are retyped. -->
						<div class="hero__sizer" aria-hidden="true">
							<p>
								I’m Iwan, a&nbsp;<span class="retype">{longestRole}</span> engineer building the
								tools I&nbsp;wish I&nbsp;had.
							</p>
							<span class="hero__cta">
								<span class="hero__cta-face">
									<span class="hero__cta-label">See what I’ve built</span>
									<span class="hero__arrow">→</span>
								</span>
								<span class="hero__cta-face">
									<span class="hero__cta-label">Click for project details</span>
									<svg class="hero__click" viewBox="0 0 24 24"></svg>
								</span>
							</span>
						</div>

						<div class="hero__layer hero__layer--sentence">
							<h1 class="hero__line">
								<span class="sr-only">
									I’m Iwan, a creative, computer vision and software engineer building the tools
									I wish I had.
								</span>
								<span class="hero__visual" aria-hidden="true" data-repel>
									<span class="hero__ink">
										I’m Iwan, a&nbsp;<span class="retype" data-retype={JSON.stringify(roles)}
											><span class="retype__text">{roles[0]}</span><span
												class="retype__caret"
											/></span
										>
										<span class="hero__engineer">engineer</span> building the tools I&nbsp;wish
										I&nbsp;had.<span
											class="hero__caret hero__caret--line"></span>
									</span>
								</span>
							</h1>

							<!-- Moves to whichever layer is showing, so it always sits
							     right under the text. -->
							<!-- Both faces are laid out in the same spot, so the link keeps
							     one size whichever is showing; only the visible one is read. -->
							<a class="hero__cta" href="/projects" data-cta>
								<span class="hero__cta-face hero__cta-face--sentence">
									<span class="hero__cta-label">See what I’ve built</span>
									<span class="hero__arrow" aria-hidden="true">→</span>
								</span>
								<span class="hero__cta-face hero__cta-face--project">
									<span class="hero__cta-label">Click for project details</span>
									<svg
										class="hero__click"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="M9.5 9.5 20 13.8l-4.6 1.6-1.6 4.6z" />
										<path d="M7.5 2.5 8.2 5.6M2.5 7.5l3.1.7M13.2 4.2l-2 2M4.2 13.2l2-2" />
									</svg>
								</span>
							</a>
						</div>

						<!-- Each line holds its full text from the start: what is written
						     so far, the caret, then the rest, laid out but invisible. The
						     lines never rewrap while they are being written. The cards
						     already name their project for assistive tech. -->
						<div class="hero__layer hero__project">
							<p class="hero__project-name" aria-hidden="true">
								<span class="hero__project-name-text"></span><span
									class="hero__caret hero__caret--name"></span><span class="hero__ghost"></span>
							</p>
							<p class="hero__project-description" aria-hidden="true">
								<span class="hero__project-description-text"></span><span
									class="hero__caret hero__caret--description"></span><span class="hero__ghost"
								></span>
							</p>
						</div>
					</div>
				</div>
			</div>
		</main>
	</body>
</html>

<style>
	:global(html),
	:global(body) {
		block-size: 100%;
		/* The landing page is a single screen — nothing below the fold. */
		overflow: hidden;
	}

	:global(body) {
		--ink: #f2f3f5;
		--muted: rgba(242, 243, 245, 0.5);

		margin: 0;
		background: #000;
		color: var(--ink);
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-weight: 350;
	}

	.stage {
		position: relative;
		display: grid;
		block-size: 100dvh;
		overflow: hidden;
	}

	/* The headline sits on the right half and runs to the gutter. The cascade
	   owns the left half. */
	.hero {
		position: relative;
		z-index: 1;
		grid-area: 1 / 1;
		place-self: center end;
		display: grid;
		justify-items: end;
		padding-block: clamp(4.5rem, 10vh, 7rem) clamp(2rem, 6vh, 4rem);
		padding-inline-end: clamp(1.5rem, 5vw, 6rem);
		pointer-events: none;
	}

	.hero__body {
		max-inline-size: min(44vw, 46rem);
	}

	/* --- Headline and project layers -------------------------------------- */

	/* The sentence and the project share one cell; the sizer sets its height.
	   The project layer is taken out of flow, so a taller project runs on
	   below instead of recentring the hero. The sentence is dimmed so the role
	   carries it. */
	.hero__morph {
		position: relative;
		display: grid;
		color: var(--muted);
		font-size: clamp(2rem, 4.1vw, 4.8rem);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.hero__morph > * {
		grid-area: 1 / 1;
		align-self: start;
		margin: 0;
	}

	.hero__sizer,
	.hero__layer {
		display: grid;
		align-content: start;
		justify-items: start;
	}

	.hero__sizer {
		visibility: hidden;
	}

	.hero__sizer p {
		margin: 0;
	}

	.hero__project {
		position: absolute;
		inset: 0 0 auto;
	}

	/* The unwritten rest of a line being drawn. The sentence's are made by the
	   script at runtime, hence :global. */
	.hero__morph :global(.hero__ghost) {
		visibility: hidden;
	}

	.hero__line {
		margin: 0;
		font: inherit;
	}

	/* The offset parent for the word positions the repel script reads. */
	.hero__visual {
		display: block;
		position: relative;
	}

	/* Words are wrapped by the script at runtime, hence :global. Each needs a
	   box of its own to be pushed. */
	.hero__visual :global(.w),
	.retype,
	.hero__engineer {
		display: inline-block;
		white-space: nowrap;
	}

	.retype,
	.hero__project-name {
		color: var(--ink);
		font-weight: 600;
	}

	.hero__engineer {
		color: var(--ink);
		font-weight: 600;
	}

	.hero__project,
	.hero__morph.show-project .hero__layer--sentence {
		visibility: hidden;
	}

	.hero__morph.show-project .hero__project {
		visibility: visible;
	}

	/* The name in the role's white, the description beneath it at the same
	   size in the sentence's grey — the same pairing as the headline. */
	.hero__project-name,
	.hero__project-description {
		margin: 0;
	}

	/* Balancing would even the lines out by shortening them; the description
	   fills each line to the full measure instead, only keeping a lone word
	   off the last one. */
	.hero__project-description {
		text-wrap: pretty;
	}

	/* --- Retype ----------------------------------------------------------- */

	/* The role alone is selected when it changes; the whole line, or the
	   project's name, when a card is hovered. */
	.retype.is-selected .retype__text,
	.hero__morph.is-selected .hero__ink,
	.hero__morph.is-selected .hero__project-name-text,
	.hero__morph.is-selected .hero__project-description-text {
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
		background: var(--ink);
		color: #000;
	}

	.hero__morph.is-selected .retype,
	.hero__morph.is-selected .hero__engineer {
		color: #000;
	}

	.retype__caret,
	.hero__caret::after {
		inline-size: max(2px, 0.05em);
		background: var(--ink);
		animation: blink 1s steps(1) infinite;
	}

	.retype__caret {
		display: inline-block;
		block-size: 0.9em;
		margin-inline-start: 0.05em;
		vertical-align: -0.1em;
	}

	/* The carets that write mid-line take no width and are plain inline boxes,
	   so they never push a word or open a line break where they sit. The bar
	   is drawn over the text, from just under the baseline to cap height. */
	.hero__caret {
		position: relative;
	}

	.hero__caret::after {
		content: '';
		position: absolute;
		inset-block: 0.17em 0.14em;
		inset-inline-start: 0.04em;
	}

	/* Solid while writing, hidden while selected. */
	.retype.is-typing .retype__caret,
	.hero__morph.is-naming .hero__caret--name::after,
	.hero__morph.is-describing .hero__caret--description::after,
	.hero__morph.is-typing-back .hero__caret::after {
		animation: none;
	}

	.retype.is-selected .retype__caret,
	.hero__morph.is-selected .hero__caret,
	.hero__morph.is-selected .retype__caret {
		visibility: hidden;
	}

	/* The role's caret at rest, the line's end while the sentence is drawn
	   back. A project is written by two carets at once, one on the name and
	   one on the description; the description's stays once both are done. */
	.hero__caret,
	.hero__morph.is-typing-back .retype__caret {
		display: none;
	}

	.hero__morph.is-naming .hero__caret--name,
	.hero__morph.show-project .hero__caret--description,
	.hero__morph.is-typing-back .hero__caret--line {
		display: inline;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.sr-only {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* --- CTA -------------------------------------------------------------- */

	/* Reads as the sentence carrying on: the headline's face and grey at a
	   smaller size, set straight under it. On hover it brightens and an
	   underline draws in. */
	.hero__cta {
		display: inline-grid;
		margin-block-start: 1.20em;
		align-items: baseline;
		color: var(--muted);
		font-size: clamp(1.2rem, 1.9vw, 2.1rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		text-decoration: none;
		pointer-events: auto;
		transition: color 240ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.hero__cta:hover,
	.hero__cta:focus-visible {
		color: var(--ink);
	}

	.hero__cta-label {
		padding-block-end: 0.08em;
		background: linear-gradient(var(--ink), var(--ink)) no-repeat left bottom / 0% 1px;
		transition: background-size 420ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.hero__cta:hover .hero__cta-label,
	.hero__cta:focus-visible .hero__cta-label {
		background-size: 100% 1px;
	}

	.hero__cta:focus-visible {
		outline: 2px solid rgba(242, 243, 245, 0.75);
		outline-offset: 4px;
	}

	.hero__arrow {
		transition: translate 240ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.hero__cta:hover .hero__arrow,
	.hero__cta:focus-visible .hero__arrow {
		translate: 0.25em 0;
	}

	/* The two faces share one cell, lined up on their baseline. Changing
	   face is a plain crossfade; the link itself never moves. */
	.hero__cta-face {
		display: inline-flex;
		grid-area: 1 / 1;
		gap: 0.4em;
		align-items: baseline;
		transition:
			opacity 220ms cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s linear 0s;
	}

	.hero__cta-face--project,
	.show-project .hero__cta-face--sentence {
		opacity: 0;
		visibility: hidden;
		transition-delay: 0s, 220ms;
	}

	.show-project .hero__cta-face--project {
		opacity: 1;
		visibility: visible;
		transition-delay: 0s;
	}

	.hero__click {
		align-self: center;
		inline-size: 0.85em;
		block-size: 0.85em;
		transition: scale 240ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.hero__cta:hover .hero__click,
	.hero__cta:focus-visible .hero__click {
		scale: 1.12;
	}

	@media (max-width: 900px) {
		/* There is no room for two columns, so the arc slides behind the type and
		   the headline takes the middle of the screen. */
		.hero {
			place-self: center;
			justify-items: center;
			padding-inline: clamp(1.25rem, 6vw, 3rem);
			text-align: center;
		}

		/* A pool of black under the type: the tiles stay visible around it, but
		   never directly behind a line of text. */
		.hero::before {
			content: '';
			position: absolute;
			z-index: -1;
			inset: -12% -20%;
			pointer-events: none;
			background: radial-gradient(
				ellipse at center,
				#000 0%,
				rgba(0, 0, 0, 0.92) 42%,
				rgba(0, 0, 0, 0) 72%
			);
		}

		.hero__body {
			max-inline-size: 36rem;
		}

		.hero__sizer,
		.hero__layer,
		.hero__cta {
			justify-items: center;
		}

		.hero__morph {
			font-size: clamp(1.9rem, 8vw, 3.4rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__cta,
		.hero__cta-face,
		.hero__cta-label,
		.hero__arrow,
		.hero__click {
			transition: none;
		}

		.retype__caret,
		.hero__caret::after {
			animation: none;
		}
	}
</style>

<script>
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

	const line = document.querySelector<HTMLElement>('[data-repel]');
	const ink = line?.querySelector<HTMLElement>('.hero__ink');

	const textNodes = (root: Node) => {
		const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
		const nodes: Text[] = [];
		while (walker.nextNode()) nodes.push(walker.currentNode as Text);
		return nodes;
	};

	// The source's line breaks and tabs become single spaces (no-break spaces are
	// kept), so the sentence can be typed back character by character.
	if (ink) {
		const nodes = textNodes(ink);
		for (const node of nodes) node.data = node.data.replace(/[ \t\n\r]+/g, ' ');
		nodes[0].data = nodes[0].data.trimStart();
		nodes.at(-1)!.data = nodes.at(-1)!.data.trimEnd();
	}

	/* ------------------------------------------------------------------ repel */

	// Words part around the cursor and spring back once it has gone. Each word is
	// pushed as a whole, over a wide reach and a short distance, so the sentence
	// stays readable while it moves. The role moves as one block with them.
	const canRepel =
		window.matchMedia('(hover: hover) and (pointer: fine)').matches && !reduce;

	if (line && ink && canRepel) {
		// Wrap each word of the sentence's own text in a span. The role and
		// "engineer" are elements already, so they are left as they are.
		for (const node of [...ink.childNodes]) {
			if (node.nodeType !== Node.TEXT_NODE) continue;
			const fragment = document.createDocumentFragment();
			for (const part of (node.textContent ?? '').split(/(\s+)/)) {
				if (!part) continue;
				if (/^\s+$/.test(part)) {
					fragment.append(part);
					continue;
				}
				const word = document.createElement('span');
				word.className = 'w';
				word.textContent = part;
				fragment.append(word);
			}
			node.replaceWith(fragment);
		}

		const targets = [...line.querySelectorAll<HTMLElement>('.w, [data-retype], .hero__engineer')];
		const state = targets.map(() => ({ amount: 0, velocity: 0, dx: 0, dy: -1 }));

		const REACH = 2.4; // em of the headline, from the cursor to where the push dies
		const SHOVE = 0.22; // em a word travels at full push
		const TILT = 3; // deg at full push
		const STIFFNESS = 0.1;
		const DAMPING = 0.8;

		let pointer: { x: number; y: number } | null = null;
		let frame = 0;

		const step = () => {
			const reach = REACH * parseFloat(getComputedStyle(line).fontSize);
			const box = line.getBoundingClientRect();
			// offsetLeft/Top ignore transforms, so these are the resting positions.
			const centres = targets.map((t) => [
				t.offsetLeft + t.offsetWidth / 2,
				t.offsetTop + t.offsetHeight / 2,
			]);
			let moving = false;

			targets.forEach((target, i) => {
				const s = state[i];
				let goal = 0;

				if (pointer) {
					const dx = centres[i][0] - (pointer.x - box.left);
					const dy = centres[i][1] - (pointer.y - box.top);
					const distance = Math.hypot(dx, dy) || 1;
					const t = Math.max(0, 1 - distance / reach);
					goal = t * t * (3 - 2 * t);
					if (goal > 0.01) {
						s.dx = dx / distance;
						s.dy = dy / distance;
					}
				}

				s.velocity = (s.velocity + (goal - s.amount) * STIFFNESS) * DAMPING;
				s.amount += s.velocity;
				if (Math.abs(s.velocity) > 0.0005 || Math.abs(goal - s.amount) > 0.001) moving = true;

				const amount = Math.max(0, s.amount);
				const push = amount * SHOVE;
				target.style.transform =
					amount < 0.001
						? ''
						: `translate(${(s.dx * push).toFixed(3)}em, ${(s.dy * push).toFixed(3)}em) rotate(${(s.dx * amount * TILT).toFixed(2)}deg)`;
			});

			// Idle once every word is home, so nothing runs over a still line.
			frame = moving ? requestAnimationFrame(step) : 0;
		};

		const wake = () => {
			if (!frame) frame = requestAnimationFrame(step);
		};

		// The hero ignores the pointer so the cascade under it stays clickable,
		// so the cursor is followed on the window instead.
		window.addEventListener(
			'pointermove',
			(event) => {
				if (event.pointerType !== 'mouse') return;
				pointer = { x: event.clientX, y: event.clientY };
				wake();
			},
			{ passive: true },
		);

		const release = () => {
			pointer = null;
			wake();
		};

		document.addEventListener('pointerleave', release);
		window.addEventListener('blur', release);
	}

	/* ----------------------------------------------------------------- retype */

	// Two things retype the headline, and never at once:
	// - every few seconds the role is selected and the next one typed over it;
	// - hovering a card selects the whole line, then two carets write the
	//   project's name and its description side by side. Leaving selects both
	//   and draws the sentence back with the default role, and only then does
	//   the role's clock start again, a full interval later.
	// Each sequence takes a number from `run`; a newer one makes an older one
	// stop at its next step. Reduced motion swaps the text outright.
	const INTERVAL = 4500;
	const REDRAW = 1700; // ms to draw the whole sentence back
	const NAME = { perChar: 90, min: 380, max: 2000 }; // ms to write a project's name
	const DESCRIBE = { perChar: 40, min: 420, max: 20050 }; // ms to write its description

	// Quick off the mark, settling gently at the end.
	const easeOut = (t: number) => 1 - (1 - t) ** 3;

	const durationFor = (text: string, { perChar, min, max }: typeof NAME) =>
		Math.min(max, Math.max(min, text.length * perChar));
	const morph = document.querySelector<HTMLElement>('[data-morph]');
	const slot = document.querySelector<HTMLElement>('[data-retype]');

	if (morph && slot && ink) {
		const roles: string[] = JSON.parse(slot.dataset.retype ?? '[]');
		const descriptions: Record<string, string> = JSON.parse(morph.dataset.morph ?? '{}');
		const roleText = slot.querySelector<HTMLElement>('.retype__text')!;
		const nameText = morph.querySelector<HTMLElement>('.hero__project-name-text')!;
		const descriptionText = morph.querySelector<HTMLElement>('.hero__project-description-text')!;
		const [nameGhost, descriptionGhost] = morph.querySelectorAll<HTMLElement>('.hero__ghost');
		const lineCaret = ink.querySelector<HTMLElement>('.hero__caret--line')!;
		const cta = morph.querySelector<HTMLElement>('[data-cta]')!;
		const sentenceLayer = morph.querySelector<HTMLElement>('.hero__layer--sentence')!;
		const projectLayer = morph.querySelector<HTMLElement>('.hero__project')!;

		// Swaps the visible layer and takes the link along, so it stays right
		// under whichever text is showing.
		const showLayer = (project: boolean) => {
			morph.classList.toggle('show-project', project);
			(project ? projectLayer : sentenceLayer).append(cta);
		};

		// Whenever the text above it changes height (a layer swap, a role that
		// takes another line), the link glides to its new place instead of
		// jumping, starting from wherever it is on screen, even mid-glide. It
		// holds still for a beat first, so the text moves before the link does.
		// Both layers start at the top of the block, so `offsetTop` compares
		// across them.
		if (!reduce) {
			let settled = cta.offsetTop;
			let glide: Animation | null = null;

			new MutationObserver(() => {
				const target = cta.offsetTop;
				if (target === settled) return;
				const drift = cta.getBoundingClientRect().top - morph.getBoundingClientRect().top - target;
				const offset = settled + drift - target;
				settled = target;
				glide?.cancel();
				glide = cta.animate([{ transform: `translateY(${offset}px)` }, { transform: 'none' }], {
					duration: 850,
					delay: 0,
					fill: 'backwards',
					easing: 'cubic-bezier(0.42, 1, 0.46, 1)',
				});
			}).observe(morph, {
				subtree: true,
				childList: true,
				characterData: true,
				attributes: true,
				attributeFilter: ['class'],
			});

			// A resize moves it with everything else; no glide for that.
			window.addEventListener('resize', () => {
				settled = cta.offsetTop;
			});
		}

		let index = 0;
		let run = 0;
		// The project the hero is showing or heading to; null for the sentence.
		let shown: string | null = null;

		// The sentence's own text outside the role, as it reads at rest. The role
		// is rewritten wholesale, so it is restored from `roles` instead.
		const sentence = textNodes(ink)
			.filter((node) => !roleText.contains(node))
			.map((node) => ({ node, full: node.data }));

		const restore = () => {
			for (const rest of ink.querySelectorAll('.hero__ghost')) rest.remove();
			roleText.textContent = roles[index];
			for (const { node, full } of sentence) node.data = full;
			ink.append(lineCaret);
			slot.classList.remove('is-selected', 'is-typing');
			morph.classList.remove('is-typing-back');
		};

		// Writes text out in one eased stroke, a frame at a time, across as many
		// text nodes as it spans. A part with a `ghost` keeps the unwritten rest
		// there, invisible, so its lines are laid out once and never rewrap. A
		// `caret`, if given, is kept at the point being written.
		// Resolves false if a newer sequence took over.
		type Part = { node: Text; full: string; ghost?: Text };

		const draw = (parts: Part[], duration: number, current: number, caret?: HTMLElement) =>
			new Promise<boolean>((resolve) => {
				const total = parts.reduce((sum, part) => sum + part.full.length, 0);
				const start = performance.now();
				const frame = (now: number) => {
					if (current !== run) return resolve(false);
					const t = Math.min(1, (now - start) / duration);
					let left = Math.round(easeOut(t) * total);
					for (const { node, full, ghost } of parts) {
						const count = Math.min(left, full.length);
						if (node.data.length !== count) {
							node.data = full.slice(0, count);
							if (ghost) ghost.data = full.slice(count);
						}
						left -= count;
					}
					if (caret) {
						const at = parts.find((part) => part.node.data.length < part.full.length) ?? parts.at(-1);
						if (at && caret.previousSibling !== at.node) at.node.after(caret);
					}
					if (t < 1) requestAnimationFrame(frame);
					else resolve(true);
				};
				requestAnimationFrame(frame);
			});

		const retypeRole = async (word: string) => {
			const current = ++run;
			if (reduce) {
				roleText.textContent = word;
				return;
			}
			slot.classList.add('is-selected');
			await wait(480);
			if (current !== run) return;
			slot.classList.replace('is-selected', 'is-typing');
			roleText.textContent = '';
			for (const ch of word) {
				await wait(45 + Math.random() * 55);
				if (current !== run) return;
				roleText.textContent += ch;
			}
			slot.classList.remove('is-typing');
		};

		// The role's clock. It is stopped while a project shows and restarted
		// once the sentence is fully back, so a role change never lands on top
		// of the redraw.
		let roleTimer = 0;

		const scheduleRole = () => {
			clearTimeout(roleTimer);
			roleTimer = window.setTimeout(nextRole, INTERVAL);
		};

		const nextRole = () => {
			if (shown) return;
			if (!document.hidden) {
				index = (index + 1) % roles.length;
				retypeRole(roles[index]);
			}
			scheduleRole();
		};

		const showProject = async (title: string) => {
			const current = ++run;
			const fromName = morph.classList.contains('show-project');
			const text = descriptions[title] ?? '';
			clearTimeout(roleTimer);
			shown = title;
			restore();
			morph.classList.remove('is-naming', 'is-describing');

			if (reduce) {
				nameText.textContent = title;
				descriptionText.textContent = text;
				nameGhost.textContent = '';
				descriptionGhost.textContent = '';
				showLayer(true);
				return;
			}

			// Select what is on screen: the sentence, or the last project.
			morph.classList.add('is-selected');
			await wait(fromName ? 260 : 380);
			if (current !== run) return;
			morph.classList.remove('is-selected');

			// Two carets, one per line, writing at the same time. Each line starts
			// out whole but invisible, and is revealed rather than grown.
			const lines = [
				{ text: nameText, rest: nameGhost, full: title, timing: NAME, state: 'is-naming' },
				{
					text: descriptionText,
					rest: descriptionGhost,
					full: text,
					timing: DESCRIBE,
					state: 'is-describing',
				},
			].map((entry) => {
				const ghost = document.createTextNode(entry.full);
				const part: Part = { node: document.createTextNode(''), full: entry.full, ghost };
				entry.text.replaceChildren(part.node);
				entry.rest.replaceChildren(ghost);
				return { ...entry, part };
			});
			morph.classList.add('is-naming', 'is-describing');
			showLayer(true);

			await Promise.all(
				lines.map(({ part, timing, state }) =>
					draw([part], durationFor(part.full, timing), current).then((done) => {
						if (done) morph.classList.remove(state);
					}),
				),
			);
		};

		const hideProject = async () => {
			const current = ++run;
			shown = null;
			// The sentence always comes back on the default role.
			index = 0;
			morph.classList.remove('is-naming', 'is-describing');

			if (reduce || !morph.classList.contains('show-project')) {
				restore();
				morph.classList.remove('is-selected');
				showLayer(false);
				scheduleRole();
				return;
			}

			morph.classList.add('is-selected');
			await wait(260);
			if (current !== run) return;
			morph.classList.remove('is-selected');
			showLayer(false);

			// Draw the sentence back, role included, in one eased stroke. Like the
			// project's lines, each piece keeps its unwritten rest beside it,
			// invisible, so the sentence holds its full shape — and the link
			// below it its place — while it is written.
			restore();
			const parts: Part[] = textNodes(ink)
				.filter((node) => node.data.length > 0)
				.map((node) => {
					const rest = document.createElement('span');
					rest.className = 'hero__ghost';
					const ghost = document.createTextNode(node.data);
					rest.append(ghost);
					node.after(rest);
					const full = node.data;
					node.data = '';
					return { node, full, ghost };
				});
			parts[0]?.node.after(lineCaret);
			morph.classList.add('is-typing-back');
			if (!(await draw(parts, REDRAW, current, lineCaret))) return;
			restore();
			scheduleRole();
		};

		scheduleRole();

		// A short grace before typing the sentence back, so sliding from one card
		// to the next goes straight from name to name.
		let leaveTimer = 0;

		document.addEventListener('cascade:project', (event) => {
			const title = (event as CustomEvent<string | null>).detail;
			clearTimeout(leaveTimer);
			if (title) {
				if (title !== shown) showProject(title);
			} else {
				leaveTimer = window.setTimeout(() => {
					if (shown) hideProject();
				}, 150);
			}
		});
	}
</script>
