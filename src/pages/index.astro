---
import Cascade from '../shared/cascade/Cascade.astro';
import Nav from '../shared/nav/Nav.astro';

// The clips that drift through the cascade behind the headline.
const projects = [
	{ title: 'MorphoX', video: '/project_animation/MorphoX_animation.mp4', href: '/morphox' },
	{
		title: 'Vectorfield Pathfinding',
		video: '/project_animation/VFP_animation.mp4',
		href: '/vectorfield-pathfinding',
	},
	{
		title: 'Dither Plugin',
		video: '/project_animation/DitherPlugin5_animation.mp4',
		href: '/dither-plugin',
	},
	{
		title: 'Privacy Plugin',
		video: '/project_animation/PPlugin3_animation.mp4',
		href: '/privacy-plugin',
	},
	{ title: 'YOLO on NPU', video: '/project_animation/NPU2_animation.mp4', href: '/yolo-npu' },
	{ title: 'Bowde', video: '/project_animation/BOWDE_animation.mp4', href: '/bowde' },
	{
		title: 'Image2Complex',
		video: '/project_animation/Image2Complex_animation.mp4',
		href: 'https://nnnawi.github.io/Image2complex/',
	},
	{ title: 'SirAMP', video: '/project_animation/SIRAMP_animation.mp4', href: undefined },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Iwan — creative engineer building software where art, technology and curiosity meet."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Instrument+Serif:ital@0;1&display=swap"
		/>
		<title>Iwan — Creative engineer</title>
	</head>
	<body>
		<Nav active="/" />

		<main class="stage">
			<Cascade items={projects} />

			<!-- No wordmark: a sentence carries the page, with the serif picking out
			     the two halves of the story. -->
			<div class="hero">
				<div class="hero__body">
					<p class="hero__kicker">
						<span class="hero__name">Iwan Ibnoulouafi</span>
						<span>Creative engineer, Paris</span>
					</p>
					<h1 class="hero__line">
						Engineer by training, <em>editor</em> by trade — I build the <em>tools</em> I wished
						I&nbsp;had.
					</h1>
					<a class="hero__cta" href="/projects">
						See the work <span class="hero__arrow" aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</main>
	</body>
</html>

<style>
	:global(html),
	:global(body) {
		block-size: 100%;
		/* The landing page is a single screen — nothing below the fold. */
		overflow: hidden;
	}

	:global(body) {
		--ink: #f2f3f5;
		--faint: rgba(242, 243, 245, 0.38);
		--rule: rgba(242, 243, 245, 0.18);
		--serif: 'Instrument Serif', Georgia, 'Times New Roman', serif;

		margin: 0;
		background: #000;
		color: var(--ink);
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-weight: 350;
	}

	.stage {
		position: relative;
		display: grid;
		block-size: 100dvh;
		overflow: hidden;
	}

	/* The headline sits on the right half and runs to the gutter. The cascade
	   owns the left half. */
	.hero {
		position: relative;
		z-index: 1;
		grid-area: 1 / 1;
		place-self: center end;
		display: grid;
		justify-items: end;
		padding-block: clamp(4.5rem, 10vh, 7rem) clamp(2rem, 6vh, 4rem);
		padding-inline-end: clamp(1.5rem, 5vw, 6rem);
		pointer-events: none;
	}

	.hero__body {
		display: grid;
		justify-items: start;
		gap: clamp(1.2rem, 3vh, 2rem);
		max-inline-size: min(44vw, 46rem);
	}

	.hero__kicker {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1rem;
		align-items: baseline;
		margin: 0;
		color: var(--faint);
		font-size: 0.82rem;
		letter-spacing: 0.02em;
	}

	/* The signature: well above the small print, well below the headline. */
	.hero__name {
		color: var(--ink);
		font-size: clamp(1.15rem, 1.65vw, 1.7rem);
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.hero__line {
		margin: 0;
		font-size: clamp(2rem, 4.1vw, 4.8rem);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.hero__line em {
		font-family: var(--serif);
		font-size: 1.1em;
		font-style: italic;
		font-weight: 400;
		letter-spacing: -0.01em;
	}

	.hero__cta {
		display: inline-flex;
		gap: 0.5rem;
		align-items: center;
		padding-block-end: 0.3rem;
		border-block-end: 1px solid var(--rule);
		color: var(--ink);
		font-size: 0.9rem;
		text-decoration: none;
		pointer-events: auto;
		transition: border-color 200ms ease;
	}

	.hero__cta:hover {
		border-color: var(--ink);
	}

	.hero__cta:focus-visible {
		outline: 2px solid rgba(242, 243, 245, 0.75);
		outline-offset: 4px;
	}

	.hero__arrow {
		transition: translate 200ms ease;
	}

	.hero__cta:hover .hero__arrow {
		translate: 0.25rem 0;
	}

	@media (max-width: 900px) {
		/* There is no room for two columns, so the arc slides behind the type and
		   the headline takes the middle of the screen. */
		.hero {
			place-self: center;
			justify-items: center;
			padding-inline: clamp(1.25rem, 6vw, 3rem);
			text-align: center;
		}

		/* A pool of black under the type: the tiles stay visible around it, but
		   never directly behind a line of text. */
		.hero::before {
			content: '';
			position: absolute;
			z-index: -1;
			inset: -12% -20%;
			pointer-events: none;
			background: radial-gradient(
				ellipse at center,
				#000 0%,
				rgba(0, 0, 0, 0.92) 42%,
				rgba(0, 0, 0, 0) 72%
			);
		}

		.hero__body {
			justify-items: center;
			max-inline-size: 36rem;
		}

		.hero__kicker {
			justify-content: center;
		}

		.hero__line {
			font-size: clamp(1.9rem, 8vw, 3.4rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__cta,
		.hero__arrow {
			transition: none;
		}
	}
</style>
