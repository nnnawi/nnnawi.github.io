---
import Cascade from '../shared/cascade/Cascade.astro';
import Nav from '../shared/nav/Nav.astro';

// The clips that drift through the cascade behind the wordmark.
const projects = [
	{ title: 'MorphoX', video: '/project_animation/MorphoX_animation.mp4', href: '/morphox' },
	{
		title: 'Vectorfield Pathfinding',
		video: '/project_animation/VFP_animation.mp4',
		href: '/vectorfield-pathfinding',
	},
	{
		title: 'Dither Plugin',
		video: '/project_animation/DitherPlugin5_animation.mp4',
		href: '/dither-plugin',
	},
	{
		title: 'Privacy Plugin',
		video: '/project_animation/PPlugin3_animation.mp4',
		href: '/privacy-plugin',
	},
	{ title: 'YOLO on NPU', video: '/project_animation/NPU2_animation.mp4', href: '/yolo-npu' },
	{ title: 'Bowde', video: '/project_animation/BOWDE_animation.mp4', href: '/bowde' },
	{
		title: 'Image2Complex',
		video: '/project_animation/Image2Complex_animation.mp4',
		href: 'https://nnnawi.github.io/Image2complex/',
	},
	{ title: 'SirAMP', video: '/project_animation/SIRAMP_animation.mp4', href: undefined },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Iwan — creative engineer building software where art, technology and curiosity meet."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
		/>
		<title>Iwan — Creative engineer</title>
	</head>
	<body>
		<Nav active="/" />

		<main class="stage">
			<Cascade items={projects} />

			<div class="hero">
				<h1 class="hero__mark">
					Iwan<span class="hero__reg" aria-hidden="true">®</span>
				</h1>
				<p class="hero__copy">
					I build thoughtful software where art, technology and curiosity meet — from GPU
					sandboxes to editing tools that get out of the way.
				</p>
			</div>
		</main>
	</body>
</html>

<style>
	:global(html),
	:global(body) {
		block-size: 100%;
		/* The landing page is a single screen — nothing below the fold. */
		overflow: hidden;
	}

	:global(body) {
		margin: 0;
		background: #000;
		color: #f2f3f5;
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-weight: 350;
	}

	.stage {
		position: relative;
		display: grid;
		block-size: 100dvh;
		overflow: hidden;
	}

	/* The wordmark sits on the right half and is allowed to run past the edge,
	   the way it would on a printed cover. The cascade owns the left half. */
	.hero {
		position: relative;
		z-index: 1;
		place-self: center end;
		display: grid;
		justify-items: end;
		inline-size: 100%;
		padding-block: clamp(4.5rem, 10vh, 7rem) clamp(2rem, 6vh, 4rem);
		padding-inline-end: clamp(1.5rem, 5vw, 6rem);
		pointer-events: none;
	}

	.hero__mark {
		margin: 0;
		/* The right sidebearing is optical, not metric: the last letter is pulled
		   flush with the gutter so the block reads as a hard right edge. */
		margin-inline-end: -0.04em;
		font-size: clamp(4.5rem, 17vw, 19rem);
		font-weight: 500;
		line-height: 0.82;
		letter-spacing: -0.05em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.hero__reg {
		margin-inline-start: 0.06em;
		color: rgba(242, 243, 245, 0.42);
		font-size: 0.11em;
		font-weight: 400;
		letter-spacing: 0;
		vertical-align: 5.2em;
	}

	/* Small, quiet, and set in from the gutter so it sits under the shoulder of
	   the wordmark rather than lining up with its edge. */
	.hero__copy {
		max-inline-size: 24ch;
		margin: clamp(0.9rem, 2.2vh, 1.6rem) clamp(0rem, 14vw, 13rem) 0 0;
		color: rgba(242, 243, 245, 0.82);
		font-size: clamp(0.78rem, 0.95vw, 0.95rem);
		font-weight: 400;
		line-height: 1.45;
		letter-spacing: -0.005em;
		text-wrap: pretty;
	}

	@media (max-width: 900px) {
		/* There is no room for two columns, so the arc slides behind the type and
		   the headline takes the middle of the screen. */
		.hero {
			place-self: center;
			justify-items: center;
			padding-inline: clamp(1.25rem, 6vw, 3rem);
			text-align: center;
		}

		/* A pool of black under the type: the tiles stay visible around it, but
		   never directly behind a line of text. */
		.hero::before {
			content: '';
			position: absolute;
			z-index: -1;
			inset: -12% -20%;
			pointer-events: none;
			background: radial-gradient(
				ellipse at center,
				#000 0%,
				rgba(0, 0, 0, 0.92) 42%,
				rgba(0, 0, 0, 0) 72%
			);
		}

		.hero__mark {
			margin-inline-end: 0;
			font-size: min(20vw, 9rem);
		}

		.hero__copy {
			max-inline-size: 30ch;
			margin-inline: 0;
			text-align: center;
		}
	}
</style>
