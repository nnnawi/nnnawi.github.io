---
import BentoCard from '../shared/bento-card/BentoCard.astro';

// ---------------------------------------------------------------------------
// Project template — everything a project needs lives in this block.
// Copy this file, swap the data, keep the markup.
// ---------------------------------------------------------------------------
const project = {
	title: 'MorphoX',
	tagline: 'A GPU-accelerated computer vision sandbox for building, chaining and watching morphological operators run in real time.',
	meta: [
		{ label: 'Discipline', value: 'Computer vision · GPU compute' },
		{ label: 'Stack', value: 'C++, CUDA, ImGui' },
		{ label: 'Year', value: '2025' },
		{ label: 'Role', value: 'Self initiated' },
	],
	hero: '/project_animation/MorphoX_animation.mp4',
	sections: [
		{
			label: 'Overview',
			title: 'Morphology you can watch happen',
			body: [
				'Classical morphology is taught as a stack of formulas — erode, dilate, open, close — and then buried inside a library call that returns a finished image. MorphoX pulls the intermediate steps back out. Every operator in the chain renders its own output, so a pipeline stops being a black box and becomes something you can scrub through.',
				'The whole graph re-evaluates on the GPU as you drag a slider, which means structuring elements, thresholds and iteration counts can be explored by feel rather than by recompiling and waiting.',
			],
		},
		{
			label: 'Approach',
			title: 'One kernel per operator, one pass per frame',
			body: [
				'Each operator is a single CUDA kernel writing into a ping-pong buffer pair, so chaining costs one pass per node and nothing is copied back to the host until an export is requested. Structuring elements are uploaded once and reused across frames.',
				'The interface is deliberately flat: a node list on the left, the live result on the right, and a parameter strip that only ever shows the selected node. Nothing is hidden behind a modal.',
			],
		},
	],
	// Bento media grid — `span` drives how many of the 4 columns a tile takes.
	media: [
		{ video: '/project_animation/MorphoX_animation.mp4', caption: 'Operator chain re-evaluating live', span: 2, ratio: '16 / 9' },
		{ video: '/project_animation/Image2Complex_animation.mp4', caption: 'Kernel preview', span: 2, ratio: '16 / 9' },
		{ video: '/project_animation/DitherPlugin2_animation.mp4', caption: 'Threshold sweep across a full sequence', span: 4, ratio: '21 / 9' },
		{ video: '/project_animation/VFP_animation.mp4', caption: 'Buffer inspector', span: 2, ratio: '4 / 3' },
		{ video: '/project_animation/PPlugin_animation.mp4', caption: 'Batch export', span: 2, ratio: '4 / 3' },
	],
	next: [
		{
			title: 'Vectorfield Pathfinding',
			description: 'Crowd navigation driven by a flow field, computed on the GPU.',
			video: '/project_animation/VFP_animation.mp4',
		},
		{
			title: 'Dither Plugin',
			description: 'Professional grade dithering plugin for AE',
			video: '/project_animation/DitherPlugin4_animation.mp4',
		},
	],
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={project.tagline} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
		/>
		<title>{project.title}</title>
	</head>
	<body>
		<main>
			<a class="back-link" href="/">
				<span class="back-link__arrow" aria-hidden="true">←</span>
				Back to all projects
			</a>

			<header class="project-header">
				<h1 class="project-title">{project.title}</h1>
				<p class="project-tagline">{project.tagline}</p>

				<dl class="project-meta">
					{
						project.meta.map((item) => (
							<div class="project-meta__row">
								<dt class="project-meta__label">{item.label}</dt>
								<dd class="project-meta__value">{item.value}</dd>
							</div>
						))
					}
				</dl>
			</header>

			<figure class="hero">
				<video
					class="hero__video"
					src={project.hero}
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
					tabindex="-1"
					aria-hidden="true"
					data-project-video></video>
			</figure>

			<div class="prose">
				{
					project.sections.map((section) => (
						<section class="prose__section">
							<p class="prose__label">{section.label}</p>
							<div class="prose__body">
								<h2 class="prose__heading">{section.title}</h2>
								{section.body.map((paragraph) => (
									<p class="prose__paragraph">{paragraph}</p>
								))}
							</div>
						</section>
					))
				}
			</div>

			<section class="gallery" aria-label="Project gallery">
				<p class="gallery__label">Selected frames</p>
				<div class="bento-grid">
					{
						project.media.map((item) => (
							<figure
								class:list={['media-card', `span-${item.span}`]}
								style={`--media-ratio: ${item.ratio}`}
							>
								<video
									class="media-card__video"
									src={item.video}
									autoplay
									muted
									loop
									playsinline
									preload="metadata"
									tabindex="-1"
									aria-hidden="true"
									data-project-video
								/>
								<div class="media-card__frost" aria-hidden="true" />
								{item.caption && (
									<figcaption class="media-card__caption">{item.caption}</figcaption>
								)}
							</figure>
						))
					}
				</div>
			</section>

			<section class="next" aria-label="Other projects">
				<p class="next__label">Next projects</p>
				<div class="bento-grid">
					{
						project.next.map((item) => (
							<BentoCard
								title={item.title}
								description={item.description}
								video={item.video}
								class="span-2"
							/>
						))
					}
				</div>
			</section>

			<footer class="site-footer">
				<span>Iwan Ibnoulouafi</span>
				<a href="mailto:iwan@ibnoulouafi.com">iwan@ibnoulouafi.com</a>
			</footer>
		</main>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		background: #05070c;
		color: #e8eaf0;
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-weight: 350;
	}

	main {
		max-inline-size: 1100px;
		margin-inline: auto;
		padding: clamp(1.5rem, 5vw, 4rem) clamp(1rem, 4vw, 2rem);
	}

	/* --- Back link ------------------------------------------------------- */

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		color: rgba(232, 234, 240, 0.55);
		font-size: 0.85rem;
		letter-spacing: 0.01em;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.back-link:hover {
		color: rgba(232, 234, 240, 0.9);
	}

	.back-link__arrow {
		display: inline-block;
		transition: transform 160ms ease;
	}

	.back-link:hover .back-link__arrow {
		transform: translateX(-3px);
	}

	/* --- Header ---------------------------------------------------------- */

	.project-header {
		margin-block: clamp(2.5rem, 7vw, 5rem) clamp(1.5rem, 4vw, 2.5rem);
	}

	.project-title {
		margin: 0;
		font-size: clamp(2.75rem, 9vw, 5.5rem);
		font-weight: 350;
		line-height: 0.98;
		letter-spacing: -0.035em;
	}

	.project-tagline {
		margin: clamp(1rem, 2.5vw, 1.5rem) 0 0;
		max-inline-size: 46ch;
		font-size: clamp(1rem, 1.6vw, 1.2rem);
		line-height: 1.45;
		color: rgba(232, 234, 240, 0.62);
		text-wrap: pretty;
	}

	.project-meta {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
		margin: clamp(2rem, 5vw, 3.25rem) 0 0;
		padding-block-start: 1.25rem;
		border-block-start: 1px solid rgba(255, 255, 255, 0.09);
	}

	.project-meta__row {
		display: flex;
		flex-direction: column;
		gap: 0.4em;
	}

	.project-meta__label {
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(232, 234, 240, 0.38);
	}

	.project-meta__value {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.35;
		color: rgba(232, 234, 240, 0.88);
		text-wrap: pretty;
	}

	/* --- Hero ------------------------------------------------------------ */

	.hero {
		position: relative;
		margin: 0;
		aspect-ratio: 21 / 9;
		overflow: hidden;
		isolation: isolate;
		border-radius: 20px;
		background-color: #0a0c11;
		box-shadow:
			0 1px 2px rgba(5, 7, 12, 0.28),
			0 30px 60px -30px rgba(5, 7, 12, 0.8);
	}

	.hero__video {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		transform: scale(1.015);
	}

	/* Same liquid-glass edge treatment as the bento cards on the index page. */
	.hero::after,
	.media-card::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 4;
		pointer-events: none;
		border-radius: inherit;
		padding: 1px;
		opacity: 40%;
		background: linear-gradient(
			150deg,
			rgba(255, 255, 255, 0.75) 0%,
			rgba(255, 255, 255, 0.22) 18%,
			rgba(255, 255, 255, 0.04) 42%,
			rgba(255, 255, 255, 0.1) 70%,
			rgba(255, 255, 255, 0.45) 100%
		);
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
	}

	.hero::before,
	.media-card::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		border-radius: inherit;
		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.16) 0%,
				rgba(255, 255, 255, 0.05) 22%,
				rgba(255, 255, 255, 0) 46%
			),
			radial-gradient(
				120% 80% at 85% 0%,
				rgba(255, 255, 255, 0.12) 0%,
				rgba(255, 255, 255, 0) 55%
			);
		mix-blend-mode: screen;
	}

	/* --- Prose ----------------------------------------------------------- */

	.prose {
		display: flex;
		flex-direction: column;
		gap: clamp(2.5rem, 6vw, 4rem);
		margin-block: clamp(3rem, 8vw, 5.5rem);
	}

	.prose__section {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
		gap: clamp(1rem, 3vw, 2rem);
	}

	.prose__label {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(232, 234, 240, 0.38);
	}

	.prose__body {
		max-inline-size: 62ch;
	}

	.prose__heading {
		margin: 0 0 0.9em;
		font-size: clamp(1.35rem, 2.6vw, 1.85rem);
		font-weight: 350;
		line-height: 1.2;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.prose__paragraph {
		margin: 0 0 1em;
		font-size: clamp(0.95rem, 1.4vw, 1.05rem);
		line-height: 1.6;
		color: rgba(232, 234, 240, 0.68);
		text-wrap: pretty;
	}

	.prose__paragraph:last-child {
		margin-block-end: 0;
	}

	/* --- Bento grid ------------------------------------------------------ */

	.bento-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		align-items: start;
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
	}

	.bento-grid > .span-2 {
		grid-column: span 2;
	}

	.bento-grid > .span-4 {
		grid-column: span 4;
	}

	.gallery__label,
	.next__label {
		margin: 0 0 clamp(1rem, 2vw, 1.5rem);
		font-size: 0.72rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(232, 234, 240, 0.38);
	}

	.next {
		margin-block-start: clamp(3rem, 8vw, 5.5rem);
	}

	.media-card {
		position: relative;
		margin: 0;
		aspect-ratio: var(--media-ratio, 16 / 9);
		overflow: hidden;
		isolation: isolate;
		border-radius: 20px;
		background-color: #0a0c11;
		box-shadow:
			0 1px 2px rgba(5, 7, 12, 0.28),
			0 18px 40px -22px rgba(5, 7, 12, 0.7);
		container-type: inline-size;
	}

	.media-card__video {
		position: absolute;
		inset: 0;
		z-index: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		transform: scale(1.015);
	}

	.media-card__frost {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		backdrop-filter: blur(14px) saturate(130%);
		-webkit-backdrop-filter: blur(14px) saturate(130%);
		background: linear-gradient(
			to top,
			rgba(8, 10, 16, 0.55) 0%,
			rgba(8, 10, 16, 0.22) 30%,
			rgba(8, 10, 16, 0) 60%
		);
		mask-image: linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.6) 26%, transparent 58%);
		-webkit-mask-image: linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.6) 26%, transparent 58%);
	}

	.media-card__caption {
		position: absolute;
		inset-block-end: 0;
		inset-inline: 0;
		z-index: 3;
		padding: clamp(0.875rem, 4.5cqi, 1.5rem);
		font-size: clamp(0.75rem, 2.2cqi, 0.9rem);
		line-height: 1.35;
		color: rgba(255, 255, 255, 0.72);
		text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);
		text-wrap: pretty;
	}

	/* --- Footer ---------------------------------------------------------- */

	.site-footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		margin-block-start: clamp(3rem, 8vw, 5.5rem);
		padding-block-start: 1.25rem;
		border-block-start: 1px solid rgba(255, 255, 255, 0.09);
		font-size: 0.85rem;
		color: rgba(232, 234, 240, 0.45);
	}

	.site-footer a {
		color: inherit;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.site-footer a:hover {
		color: rgba(232, 234, 240, 0.9);
	}

	/* --- Responsive ------------------------------------------------------ */

	@media (max-width: 720px) {
		.project-meta {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.25rem;
		}

		.prose__section {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.75rem;
		}

		.bento-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.bento-grid > .span-4 {
			grid-column: span 2;
		}

		.hero {
			aspect-ratio: 16 / 9;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__video,
		.media-card__video {
			transform: none;
		}

		.back-link__arrow {
			transition: none;
		}
	}
</style>

<script>
	// Autoplaying video is motion: honour the OS setting and show the first frame instead.
	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-project-video]')) {
			video.autoplay = false;
			video.pause();
		}
	}
</script>
