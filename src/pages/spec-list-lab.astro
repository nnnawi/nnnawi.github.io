<script>
	// Variant 05 only: a roving-tabindex tab list, so the panel is reachable by
	// keyboard as well as pointer.
	for (const root of document.querySelectorAll<HTMLElement>('[data-controls]')) {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-param]')];
		const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];

		const select = (index: number, focus = false) => {
			tabs.forEach((tab, i) => {
				tab.setAttribute('aria-selected', String(i === index));
				tab.tabIndex = i === index ? 0 : -1;
			});
			panels.forEach((panel, i) => {
				panel.hidden = i !== index;
			});
			if (focus) tabs[index].focus();
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener('click', () => select(index));
			tab.addEventListener('keydown', (event) => {
				const step = event.key === 'ArrowDown' || event.key === 'ArrowRight' ? 1 : event.key === 'ArrowUp' || event.key === 'ArrowLeft' ? -1 : 0;
				if (!step) return;
				event.preventDefault();
				select((index + step + tabs.length) % tabs.length, true);
			});
		});
	}
</script>
