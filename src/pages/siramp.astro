		text-decoration: none;
		transition: color 160ms ease;
	}

	.site-footer a:hover {
		color: rgba(232, 234, 240, 0.9);
	}

	/* --- Responsive ------------------------------------------------------ */

	@media (max-width: 720px) {
		.results__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.prose__section,
		.features {
