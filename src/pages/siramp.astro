		}

		.hero {
			aspect-ratio: 16 / 9;
		}

		/* Too short at phone width to carry a paragraph, so the text drops below the image. */
		.steps__caption {
			position: static;
			padding: 0.9rem 1rem 1.1rem;
			background: none;
		}

		.steps__text {
			color: rgba(232, 234, 240, 0.75);
			text-shadow: none;
		}

		.steps__arrow {
			inline-size: 2.4rem;
			block-size: 2.4rem;
		}

		.steps__thumb {
			inline-size: 6.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.features__node,
		.features__tick {
			transition: none;
		}

		.hero__video,
		.media-card__video {
			transform: none;
		}

		.back-link__arrow,
		.steps__image,
		.zoom__image.is-easing {
			transition: none;
		}

		.zoom[open] {
			animation: none;
		}
	}
</style>

<script>
	// Autoplaying video is motion: honour the OS setting and show the first frame instead.
	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-project-video]')) {
			video.autoplay = false;
			video.pause();
		}
	}
	// Step gallery: the arrows, the thumbnails, the arrow keys and a horizontal swipe
	// all go through show(), which swaps the main image once the next one is decoded.
	const steps = document.querySelector<HTMLElement>('[data-steps]');

	if (steps) {
		const image = steps.querySelector<HTMLImageElement>('[data-steps-image]')!;
		const text = steps.querySelector<HTMLElement>('[data-steps-text]')!;
		const rail = steps.querySelector<HTMLElement>('[data-steps-rail]')!;
		const thumbs = [...steps.querySelectorAll<HTMLButtonElement>('[data-steps-thumb]')];
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let current = 0;

		const preload = (index: number) => {
			new Image().src = thumbs[(index + thumbs.length) % thumbs.length].dataset.src!;
		};

		const show = (next: number) => {
			current = (next + thumbs.length) % thumbs.length;
			const thumb = thumbs[current];
			const { src, text: body } = thumb.dataset;

			text.textContent = body!;
			thumbs.forEach((item, index) => {
				if (index === current) item.setAttribute('aria-current', 'true');
				else item.removeAttribute('aria-current');
			});

			// Centre the active thumbnail in the rail without scrolling the page.
			rail.scrollTo({
				left: thumb.offsetLeft - (rail.clientWidth - thumb.offsetWidth) / 2,
				behavior: reduceMotion ? 'auto' : 'smooth',
			});

			const target = current;
			const incoming = new Image();
			incoming.src = src!;
			image.classList.add('is-swapping');
			incoming
				.decode()
				.catch(() => {})
				.then(() => {
					// A quicker click may have moved on while this one was loading.
					if (target !== current) return;
					image.src = src!;
					image.alt = body!;
					image.classList.remove('is-swapping');
				});

			preload(current + 1);
			preload(current - 1);
		};

		steps.querySelector('[data-steps-prev]')!.addEventListener('click', () => show(current - 1));
		steps.querySelector('[data-steps-next]')!.addEventListener('click', () => show(current + 1));
		thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => show(index)));

		steps.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(current - 1);
			else if (event.key === 'ArrowRight') show(current + 1);
			else return;
			event.preventDefault();
		});

		const stage = steps.querySelector<HTMLElement>('.steps__frame')!;
		let startX: number | null = null;
		stage.addEventListener('touchstart', (event) => (startX = event.touches[0].clientX), { passive: true });
		stage.addEventListener('touchend', (event) => {
			if (startX === null) return;
			const delta = event.changedTouches[0].clientX - startX;
			startX = null;
			if (Math.abs(delta) > 40) show(current + (delta < 0 ? 1 : -1));
		});

		// Zoom view. The image is fitted to the screen, then scaled and moved with a
		// transform: wheel or pinch to zoom around the pointer, drag to pan, tap the
		// image to zoom in or back out, tap outside it to close.
		const dialog = document.querySelector<HTMLDialogElement>('[data-zoom]')!;
		const canvas = dialog.querySelector<HTMLElement>('[data-zoom-canvas]')!;
		const full = dialog.querySelector<HTMLImageElement>('[data-zoom-image]')!;
		const maxScale = 8;
		let scale = 1;
		let x = 0;
		let y = 0;

		const apply = (ease = false) => {
			full.classList.toggle('is-easing', ease);
			full.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
			canvas.classList.toggle('is-zoomed', scale > 1);
		};

		// Keep the image covering the screen on any axis where it is bigger than it.
		const clamp = () => {
			const maxX = Math.max(0, (full.offsetWidth * scale - canvas.clientWidth) / 2);
			const maxY = Math.max(0, (full.offsetHeight * scale - canvas.clientHeight) / 2);
			x = Math.min(maxX, Math.max(-maxX, x));
			y = Math.min(maxY, Math.max(-maxY, y));
		};

		// Zoom so that the point under (clientX, clientY) stays where it is.
		const zoomAt = (next: number, clientX: number, clientY: number, ease = false) => {
			next = Math.min(maxScale, Math.max(1, next));
			const rect = canvas.getBoundingClientRect();
			const px = clientX - rect.left - rect.width / 2;
			const py = clientY - rect.top - rect.height / 2;
			x = px - (next / scale) * (px - x);
			y = py - (next / scale) * (py - y);
			scale = next;
			clamp();
			apply(ease);
		};

		const zoomCentre = (factor: number) => {
			const rect = canvas.getBoundingClientRect();
			zoomAt(scale * factor, rect.left + rect.width / 2, rect.top + rect.height / 2, !reduceMotion);
		};

		const reset = (ease = false) => {
			scale = 1;
			x = 0;
			y = 0;
			apply(ease);
		};

		steps.querySelector('[data-steps-open]')!.addEventListener('click', () => {
			const { src, full: fullSrc, text: body } = thumbs[current].dataset;
			// Show the already-loaded screen version at once, then swap in full resolution.
			full.src = src!;
			full.alt = body!;
			const sharp = new Image();
			sharp.src = fullSrc!;
			sharp
				.decode()
				.then(() => {
					if (dialog.open && full.src.endsWith(src!)) full.src = fullSrc!;
				})
				.catch(() => {});
			reset();
			dialog.showModal();
		});

		dialog.querySelector('[data-zoom-close]')!.addEventListener('click', () => dialog.close());
		dialog.querySelector('[data-zoom-in]')!.addEventListener('click', () => zoomCentre(1.6));
		dialog.querySelector('[data-zoom-out]')!.addEventListener('click', () => zoomCentre(1 / 1.6));
		dialog.querySelector('[data-zoom-reset]')!.addEventListener('click', () => reset(!reduceMotion));
		dialog.addEventListener('close', () => reset());

		dialog.addEventListener('keydown', (event) => {
			if (event.key === '+' || event.key === '=') zoomCentre(1.6);
			else if (event.key === '-') zoomCentre(1 / 1.6);
			else if (event.key === '0') reset(!reduceMotion);
			else return;
			event.preventDefault();
		});

		canvas.addEventListener(
			'wheel',
			(event) => {
				event.preventDefault();
				zoomAt(scale * Math.exp(-event.deltaY * 0.0015), event.clientX, event.clientY);
			},
			{ passive: false },
		);

		const pointers = new Map<number, { x: number; y: number }>();
		let down = { x: 0, y: 0 };
		let moved = false;
		let pinched = false;
		let pinchDistance = 0;

		const spread = () => {
			const [a, b] = [...pointers.values()];
			return {
				distance: Math.hypot(a.x - b.x, a.y - b.y),
				x: (a.x + b.x) / 2,
				y: (a.y + b.y) / 2,
			};
		};

		canvas.addEventListener('pointerdown', (event) => {
			canvas.setPointerCapture(event.pointerId);
			pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
			if (pointers.size === 1) {
				down = { x: event.clientX, y: event.clientY };
				moved = false;
				pinched = false;
			} else if (pointers.size === 2) {
				pinched = true;
				pinchDistance = spread().distance;
			}
			canvas.classList.toggle('is-dragging', scale > 1);
		});

		canvas.addEventListener('pointermove', (event) => {
			const previous = pointers.get(event.pointerId);
			if (!previous) return;
			pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
			if (Math.hypot(event.clientX - down.x, event.clientY - down.y) > 4) moved = true;

			if (pointers.size === 2) {
				const { distance, x: midX, y: midY } = spread();
				zoomAt((scale * distance) / pinchDistance, midX, midY);
				pinchDistance = distance;
			} else if (scale > 1) {
				x += event.clientX - previous.x;
				y += event.clientY - previous.y;
				clamp();
				apply();
			}
		});

		const release = (event: PointerEvent) => {
			if (!pointers.delete(event.pointerId)) return;
			if (pointers.size > 0) return;
			canvas.classList.remove('is-dragging');
			if (moved || pinched || event.type === 'pointercancel') return;

			// A tap: on the image it toggles zoom, anywhere else it closes the view.
			const rect = full.getBoundingClientRect();
			const onImage =
				event.clientX >= rect.left &&
				event.clientX <= rect.right &&
				event.clientY >= rect.top &&
				event.clientY <= rect.bottom;
			if (!onImage) dialog.close();
			else if (scale > 1) reset(!reduceMotion);
			else zoomAt(2.5, event.clientX, event.clientY, !reduceMotion);
		};

		canvas.addEventListener('pointerup', release);
		canvas.addEventListener('pointercancel', release);

		window.addEventListener('resize', () => {
			if (!dialog.open) return;
			clamp();
			apply();
		});

		preload(1);
	}
</script>
